{
  "name": "hela-riichi-score",
  "version": "0.6.2",
  "private": true,
  "type": "module",
  "description": "和啦 · Japanese mahjong score calculator, yaku reference, teaching examples and practice, plus local four-player table. Shared core, WeChat mini-program, Heybox mini-program and a browser build.",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/serve-web.mjs",
    "test": "node --test test/*.test.mjs",
    "build:web": "node scripts/build-web.mjs",
    "build:single": "node scripts/build-single.mjs",
    "build:mini": "node scripts/build-miniprogram.mjs",
    "build:heybox": "node scripts/build-heybox.mjs",
    "assets:tiles": "node scripts/generate-tile-art.mjs",
    "assets:icons": "node scripts/generate-icons.mjs",
    "manifest": "node scripts/source-manifest.mjs --write",
    "check:public": "node scripts/public-scan.mjs",
    "check:assets": "node scripts/generate-tile-art.mjs --check",
    "verify": "npm run check:assets && npm run check:public && npm test",
    "release:prepare": "node scripts/release-packages.mjs",
    "release:verify": "node scripts/release-packages.mjs --verify",
    "release": "npm run build:web && npm run build:single && npm run manifest && npm run release:prepare",
    "manifest:check": "node scripts/source-manifest.mjs"
  },
  "dependencies": {
    "@kobalab/majiang-core": "1.4.1",
    "fflate": "0.8.3",
    "onnxruntime-web": "1.30.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "sharp": "0.35.5"
  }
}
