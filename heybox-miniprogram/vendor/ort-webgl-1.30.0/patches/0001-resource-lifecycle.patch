+
+// ---------------------------------------------------------------------------------------------
+// hela patch: cleanup-failure contract.
+//
+// A release that could not delete every object it owns must be observable, not swallowed. Cleanup code
+// throws `DisposeError` (code `DISPOSE_FAILED`) after it has attempted every independent resource; the
+// objects that could not be deleted stay owned, so a second release retries exactly those.
+//
+// When a run/initialization error is already in flight, `attachSuppressed` keeps the original error as the
+// error that surfaces and hangs the cleanup failure off it, so the original identity is never replaced by
+// a cleanup error.
+// ---------------------------------------------------------------------------------------------
+export class DisposeError extends Error {
+  readonly code = 'DISPOSE_FAILED';
+  readonly failures: string[];
 
+  constructor(scope: string, failures: string[]) {
+    super(`${scope}: dispose failed for ${failures.length} object(s): ${failures.join('; ')}`);
+    this.name = 'DisposeError';
+    this.failures = failures;
+  }
+}
+
+export interface SuppressedCleanupError {
+  readonly suppressed: Error;
+}
+
+/**
+ * hela patch: best-effort attachment of a cleanup failure to an error already in flight.
+ *
+ * The original error must keep its identity and must never be replaced by the cleanup error, so every write
+ * is guarded: a frozen, sealed, non-extensible or primitive value (or a throwing setter) simply yields no
+ * annotation, and the caller still throws the original error. Attaching is an observation aid, not a
+ * requirement for correctness.
+ */
+export function suppressCleanupError<T>(original: T, cleanupError: unknown): T {
+  try {
+    if (original === null || (typeof original !== 'object' && typeof original !== 'function')) {
+      return original;
+    }
+    const carrier = original as unknown as Partial<SuppressedCleanupError> & {cleanupErrors?: unknown[]};
+    if (cleanupError instanceof Error) {
+      (carrier as {suppressed?: Error}).suppressed = cleanupError;
+    }
+    const list = Array.isArray(carrier.cleanupErrors) ? carrier.cleanupErrors : [];
+    list.push(cleanupError);
+    carrier.cleanupErrors = list;
+  } catch (attachError) {
+    // Best effort only: never let the annotation attempt surface as the reported error.
+    try {
+      Logger.warning('DisposeError', `Could not annotate the original error with a cleanup failure: ${attachError}`);
+    } catch {
+      // Logging must not throw either.
+    }
+  }
+  return original;
+}
