page{height:100%;overflow:hidden}.practice-screen{display:flex;flex-direction:column;height:100vh}.practice-header{flex:none;padding:24rpx 28rpx 18rpx}.practice-title{font-family:var(--heading-font);font-size:34rpx;margin-top:8rpx}.practice-stats{color:var(--accent);font:32rpx Georgia,serif;text-align:right}.practice-stats text{display:block;font:18rpx sans-serif;color:var(--muted);margin-top:7rpx}.levels{display:flex;gap:12rpx;margin-top:22rpx}.levels button{flex:1}.practice-scroll{flex:1;min-height:0;height:0}.practice-content{padding:0 24rpx 20rpx}.practice-content .card{margin-bottom:18rpx}.practice-content .card-inner{padding:22rpx}.practice-hand{display:flex;align-items:center;gap:14rpx;margin:26rpx 0 18rpx;padding:18rpx 12rpx;border-radius:12rpx;background:var(--surface)}.practice-concealed{display:flex;flex:1;flex-wrap:wrap;gap:10rpx 6rpx;min-width:0}.practice-win{position:relative;padding-left:15rpx;border-left:1rpx dashed var(--line);flex-shrink:0}.practice-win>text{position:absolute;top:-20rpx;right:0;font-size:17rpx;color:var(--accent)}.practice-meld{display:flex;align-items:center;gap:8rpx;margin-bottom:16rpx;font-size:21rpx;color:var(--muted)}.scenario{display:grid;grid-template-columns:1fr 1fr;gap:12rpx 8rpx;font-size:23rpx;color:var(--accent)}.practice-indicators{display:flex;align-items:center;gap:10rpx;margin-top:15rpx;font-size:20rpx;color:var(--muted)}.answer-grid{display:flex;flex-wrap:wrap;gap:16rpx;margin-top:22rpx}.answer-field{width:calc(50% - 8rpx);padding:16rpx;border:1rpx solid var(--line);border-radius:10rpx;background:var(--surface)}.answer-field>text{font-size:20rpx;color:var(--accent)}.answer-field>view{display:flex;align-items:center;gap:8rpx;margin-top:10rpx}.answer-field input{flex:1;width:0;min-width:0;height:52rpx;font:34rpx Georgia,serif;color:var(--text)}.answer-field>view>text{font-size:20rpx;color:var(--muted)}.answer-field.right{border-color:var(--line)}.answer-field.wrong{border-color:var(--line);background:var(--surface)}.answer-field .expected{display:block;font-size:18rpx;margin-top:12rpx;color:var(--accent)}.answer-field.wrong .expected{color:var(--danger)}.feedback{margin-top:22rpx;color:var(--accent);font-size:25rpx}.practice-error{color:var(--danger);font-size:22rpx;margin-top:18rpx}.practice-screen .analysis-toggle{min-width:0;margin:0;display:flex;align-items:center;justify-content:space-between;width:100%;text-align:left;padding:0;background:transparent;color:var(--accent);font-size:24rpx}.analysis-toggle>text{font-size:20rpx;color:var(--muted)}.analysis-row{display:flex;justify-content:space-between;gap:16rpx;padding:19rpx 0;border-bottom:1rpx solid var(--line);font-size:23rpx;color:var(--accent)}.analysis-row>view{flex:1}.analysis-row>view>text{display:block;font-size:19rpx;color:var(--muted);margin-top:8rpx;line-height:1.8}.analysis-row>text{white-space:nowrap;font-size:22rpx}.fu-detail{display:flex;justify-content:space-between;gap:16rpx;margin-top:18rpx;font-size:20rpx;color:var(--muted)}.practice-footer{flex:none;display:flex;align-items:center;gap:15rpx;padding:18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));border-top:1rpx solid var(--line);background:var(--surface)}.practice-footer>.primary{flex:1;min-height:84rpx;font-size:28rpx}.practice-footer>.text-button{padding:20rpx 10rpx;font-size:23rpx}
