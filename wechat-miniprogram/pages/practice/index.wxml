<view class="app-shell fixed-shell theme-{{themeId}} locale-{{locale}}">
<app-header caption="{{copy.scoring_practice}}" />
<view class="practice-screen">
  <view class="practice-header"><view class="row"><view><text class="eyebrow">{{copy.eyebrow_practice}}</text><view class="practice-title">{{copy.can_you_score_this_hand}}</view></view><view class="practice-stats">{{stats.correct}} / {{stats.attempted}}<text>{{copy.correct_answered}}</text></view></view><view class="levels"><button wx:for="{{levels}}" wx:key="id" class="chip {{level === item.id ? 'selected' : ''}}" data-level="{{item.id}}" bindtap="onLevel">{{item.name}}</button></view></view>
  <scroll-view class="practice-scroll" scroll-y scroll-top="{{scrollTop}}" enhanced show-scrollbar="{{false}}"><view class="practice-content" wx:if="{{question}}">
    <view class="card card-inner question-card"><view class="row"><text class="section-title">{{copy.random_hand}}</text><text class="caption">{{copy.standard_four_player_rules_open_tanyao_allowed}}</text></view><view class="practice-hand"><view class="practice-concealed"><mahjong-tile wx:for="{{question.hand}}" wx:key="index" tile="{{item.tile}}" size="small"/></view><view class="practice-win"><text>{{copy.winning_tile}}</text><mahjong-tile tile="{{question.win}}" size="small" selected="{{true}}"/></view></view><view class="practice-meld" wx:for="{{question.melds}}" wx:key="index" wx:for-item="meld"><text>{{meld.label}}</text><mahjong-tile wx:for="{{meld.tiles}}" wx:key="index" tile="{{item.tile}}" size="tiny"/></view><view class="scenario"><text>{{question.context}}</text><text>{{question.methodText}}</text><text>{{question.riichi}}{{question.ippatsu ? copy.ippatsu_2 : ''}}{{question.special ? ' · ' + question.special : ''}}</text><text>{{question.honba}}{{copy.honba_3}}{{question.sticks}}{{copy.riichi_deposits}}</text></view><view class="practice-indicators"><text>{{copy.dora_indicators}}</text><mahjong-tile wx:for="{{question.dora}}" wx:key="index" tile="{{item.tile}}" size="tiny"/><text wx:if="{{!question.dora.length}}">{{copy.none}}</text></view><view wx:if="{{question.ura.length}}" class="practice-indicators"><text>{{copy.ura_dora_indicators}}</text><mahjong-tile wx:for="{{question.ura}}" wx:key="index" tile="{{item.tile}}" size="tiny"/></view><view class="field-note" wx:if="{{question.yakuman}}">{{copy.for_a_yakuman_enter_the_payment_amounts_directly}}</view></view>
    <view class="card card-inner"><view class="section-title">{{copy.enter_your_answer}}</view><view class="field-note">{{copy.payments_include_honba_the_total_also_includes_riichi}}{{level === 'basic' ? copy.beginner_questions_exclude_ura_dora : ''}}</view><view class="answer-grid"><view class="answer-field {{revealed && answered ? (item.correct ? 'right' : 'wrong') : ''}}" wx:for="{{fields}}" wx:key="key"><text>{{item.label}}</text><view><input type="number" maxlength="7" value="{{item.value}}" disabled="{{revealed}}" data-key="{{item.key}}" bindinput="onAnswer" placeholder="?"/><text>{{item.unit}}</text></view><text wx:if="{{revealed}}" class="expected">{{answered ? (item.correct ? copy.correct : copy.correct_answer) : copy.answer}}{{!answered || !item.correct ? item.expectedText : ''}}</text></view></view><view class="feedback" wx:if="{{revealed}}">{{feedback}}</view><view class="practice-error" wx:if="{{error}}">{{error}}</view></view>
    <view wx:if="{{revealed}}" class="card card-inner"><button class="analysis-toggle" bindtap="onAnalysis">{{answer.yakuman ? answer.limit : answer.han + copy.han_3 + answer.fu + copy.fu_2}} · {{answer.points}} {{copy.points}} <text>{{analysis ? copy.collapse : copy.show_explanation}}</text></button><block wx:if="{{analysis}}"><view class="analysis-row" wx:for="{{answer.yaku}}" wx:key="key"><view>{{item.name}}<text>{{item.description}}</text></view><text>{{item.label}}</text></view><view class="fu-detail" wx:for="{{answer.fuDetails}}" wx:key="name"><text>{{item.name}}</text><text>{{item.fu === null ? '—' : item.fu + copy.fu_2}}</text></view></block></view>
  </view><view wx:else class="practice-error">{{error}}</view></scroll-view>
  <view class="practice-footer"><button wx:if="{{!revealed}}" class="text-button" bindtap="onReveal">{{copy.reveal_answer}}</button><button wx:if="{{revealed}}" class="primary" bindtap="onNext">{{copy.next_random_hand}}</button><button wx:else class="primary" bindtap="onSubmit">{{copy.submit_answer}}</button></view>
</view>

</view>
