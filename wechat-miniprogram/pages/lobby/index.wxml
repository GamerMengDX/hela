<view class="app-shell fixed-shell theme-{{themeId}} locale-{{locale}}">
<app-header caption="{{copy.table_lobby}}" />
<view class="lobby-screen">
  <view class="lobby-header"><view class="row"><view><text class="eyebrow">{{copy.eyebrow_table}}</text><view class="lobby-title">{{copy.four_players_one_scorebook}}</view></view><text class="local-badge">{{copy.local_scores}}</text></view><view class="lobby-note">{{copy.keep_score_on_this_phone_balances_and_transfers}}</view></view>
  <scroll-view class="lobby-scroll" scroll-y enhanced show-scrollbar="{{false}}"><view class="lobby-content">
    <view wx:if="{{setup}}" class="card card-inner"><view class="section-title">{{table ? copy.start_a_new_table : copy.set_up_your_table_and_keep_score}}</view><view class="field-note">{{copy.enter_names_in_the_initial_east_south_west}}</view><view class="name-grid"><view wx:for="{{names}}" wx:key="index"><text>{{index === 0 ? copy.east_first_dealer : index === 1 ? copy.south : index === 2 ? copy.west : copy.north}}</text><input value="{{item}}" maxlength="12" data-index="{{index}}" bindinput="onName" placeholder="{{copy.player_name}}"/></view></view><view class="initial-row"><text>{{copy.starting_points_per_player}}</text><input type="number" value="{{initial}}" maxlength="6" bindinput="onInitial"/><text>{{copy.points}}</text></view><view class="field-note">{{copy.defaults_to_25_000_set_1_000_100}}</view><view class="setup-actions"><button wx:if="{{table}}" class="outline" bindtap="onCancelSetup">{{copy.cancel}}</button><button class="primary" bindtap="onCreate">{{copy.create_table}}</button></view></view>
    <block wx:elif="{{table}}"><view class="table-summary"><view><text>{{table.label}}</text><view>{{table.handProgress}}</view></view><view class="pot-summary">{{table.potText}}<text>{{copy.riichi_pot}}</text></view></view><view class="player-grid"><view class="player-card" wx:for="{{table.players}}" wx:key="index"><view class="row"><text class="player-wind">{{item.wind}}</text><text class="dealer-badge" wx:if="{{item.dealer}}">{{copy.dealer}}</text><text class="riichi-badge" wx:if="{{item.riichi}}">{{copy.riichi_declared}}</text></view><view class="player-name">{{item.name}}</view><view class="player-points">{{item.pointsText}}<text>{{copy.points}}</text></view><view class="player-change">{{copy.from_start}}{{item.changeText}}</view><button class="riichi-button" wx:if="{{table.phase === 'playing'}}" disabled="{{item.riichi || !(item.points >= 1000)}}" data-index="{{item.index}}" bindtap="onRiichi">{{item.riichi ? copy.riichi_deposit_paid : copy.riichi_1_000}}</button></view></view>
      <view wx:if="{{table.phase === 'settled'}}" class="card card-inner"><view class="section-title">{{copy.this_hand_has_been_settled}}</view><view class="field-note">{{copy.choose_whether_the_dealer_repeats_or_rotates_then}}</view><view class="next-options"><button class="outline" data-repeat="yes" bindtap="onNext">{{copy.dealer_repeats_next_hand}}</button><button class="primary" data-repeat="no" bindtap="onNext">{{copy.rotate_dealer_next_hand}}</button></view><button class="text-button undo-button" bindtap="onUndo">{{copy.entry_mistake_undo_this_settlement}}</button></view>
      <view wx:if="{{table.phase === 'playing'}}" class="draw-area"><button class="outline full" bindtap="onDraw">{{showDraw ? copy.hide_draw_settlement : copy.draw_settlement}}</button><view wx:if="{{showDraw}}" class="card card-inner draw-card"><text class="section-title">{{copy.select_players_in_tenpai}}</text><view class="tenpai-options"><button wx:for="{{table.players}}" wx:key="index" class="chip {{tenpai[index] ? 'selected' : ''}}" data-index="{{index}}" bindtap="onTenpai">{{item.name}} {{tenpai[index] ? '✓' : ''}}</button></view><button class="primary full" bindtap="onConfirmDraw">{{copy.settle_draw}}</button></view></view>
      <view class="card card-inner records-card"><button class="records-toggle" bindtap="onRecords"><text>{{copy.table_transfers}}<text class="caption">{{table.records.length}}{{copy.records}}</text></text><text>{{recordsExpanded ? copy.collapse : copy.expand}}</text></button><block wx:if="{{recordsExpanded}}"><view wx:if="{{!table.records.length}}" class="field-note">{{copy.no_settlements_yet}}</view><view wx:for="{{table.records}}" wx:key="id" wx:for-item="record" class="ledger-record"><view class="row"><text>{{record.title}}{{record.voided ? copy.undone : ''}}</text><text class="caption">{{record.label}}</text></view><view class="ledger-changes"><text wx:for="{{record.players}}" wx:key="name">{{item.name}} {{item.delta}}</text></view></view></block></view>
      <view class="lobby-tools"><button class="text-button" bindtap="onCopy">{{copy.copy_transfers}}</button><button class="text-button" bindtap="onSetup">{{copy.start_a_new_table}}</button></view><view class="lobby-footnote">{{copy.seat_winds_rotate_with_the_dealer_pay_riichi}}</view>
    </block>
    <view class="lobby-error" wx:if="{{error}}">{{error}}</view>
  </view></scroll-view>
  <view class="lobby-footer" wx:if="{{table && !setup}}"><view>{{table.phase === 'playing' ? copy.confirm_the_score_to_transfer_points_automatically : copy.choose_repeat_or_rotate_first}}</view><button class="primary" disabled="{{table.phase !== 'playing'}}" bindtap="onCalculate">{{copy.enter_hand_and_settle}}</button></view>
</view>

</view>
