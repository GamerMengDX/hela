page{height:100%;overflow:hidden}.lobby-screen{display:flex;flex-direction:column;height:100vh}.lobby-header{flex:none;padding:26rpx 28rpx 20rpx}.lobby-title{font-family:var(--heading-font);font-size:35rpx;margin-top:8rpx}.local-badge{border:1rpx solid var(--line);background:var(--surface);padding:8rpx 13rpx;border-radius:8rpx;font-size:19rpx;color:var(--accent);white-space:nowrap}.lobby-note{font-size:21rpx;color:var(--muted);margin-top:12rpx}.lobby-scroll{flex:1;min-height:0;height:0}.lobby-content{padding:0 24rpx 20rpx}.lobby-content .card{margin-bottom:20rpx}.lobby-content .card-inner{padding:24rpx}.name-grid{display:flex;flex-wrap:wrap;gap:20rpx;margin-top:26rpx}.name-grid>view{width:calc(50% - 10rpx)}.name-grid text{font-size:22rpx;color:var(--muted)}.name-grid input{margin-top:10rpx;height:80rpx;background:var(--surface);border:1rpx solid var(--line);border-radius:10rpx;padding:16rpx;font-size:26rpx;color:var(--accent)}.initial-row{display:flex;align-items:center;gap:14rpx;margin-top:30rpx;color:var(--muted);font-size:23rpx}.initial-row input{flex:1;width:0;height:78rpx;background:var(--surface);border:1rpx solid var(--line);border-radius:10rpx;padding:16rpx;font:30rpx Georgia,serif}.setup-actions{display:flex;gap:14rpx;margin-top:28rpx}.setup-actions button{flex:1;font-size:27rpx}.table-summary{display:flex;align-items:center;justify-content:space-between;padding:22rpx 25rpx;background:var(--surface);border-radius:15rpx;color:var(--muted);margin-bottom:22rpx}.table-summary>view>text{font-size:28rpx}.table-summary>view>view{color:var(--muted);font-size:19rpx;margin-top:8rpx}.pot-summary{font:36rpx Georgia,serif;text-align:right}.pot-summary>text{display:block;font:18rpx sans-serif;color:var(--muted);margin-top:8rpx}.player-grid{display:flex;flex-wrap:wrap;justify-content:space-between;gap:18rpx 0;margin-bottom:22rpx}.player-card{width:48.5%;padding:22rpx;background:var(--surface);border:1rpx solid var(--line);border-radius:16rpx}.player-wind{display:flex;align-items:center;justify-content:center;width:42rpx;height:42rpx;border:1rpx solid var(--line);border-radius:8rpx;background:var(--surface);color:var(--muted);font-family:serif;font-size:28rpx}.dealer-badge,.riichi-badge{font-size:17rpx;color:var(--muted)}.riichi-badge{color:var(--danger)}.player-name{font-size:26rpx;margin-top:13rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.player-points{font:43rpx Georgia,serif;color:var(--accent);margin-top:7rpx}.player-points>text{font:18rpx sans-serif;color:var(--muted);margin-left:7rpx}.player-change{font-size:18rpx;color:var(--muted);margin:8rpx 0 17rpx}.lobby-screen .riichi-button{display:block;min-width:0;max-width:100%;margin:0;width:100%;padding:17rpx 4rpx;border:1rpx solid var(--line);background:var(--surface);color:var(--accent);font-size:23rpx}.next-options{display:flex;gap:15rpx;margin-top:22rpx}.next-options button{flex:1;min-width:0;font-size:24rpx;padding:20rpx 8rpx}.draw-area{margin-bottom:22rpx}.draw-card{margin-top:16rpx}.tenpai-options{display:flex;flex-wrap:wrap;gap:12rpx;margin:22rpx 0}.tenpai-options button{flex:1 0 44%;min-width:0}.lobby-screen .records-toggle{min-width:0;margin:0;display:flex;justify-content:space-between;align-items:center;width:100%;background:transparent;padding:0;text-align:left;color:var(--accent);font-size:26rpx}.records-toggle>text:last-child{font-size:20rpx;color:var(--muted)}.ledger-record{padding:20rpx 0;border-top:1rpx solid var(--line);margin-top:20rpx;font-size:23rpx;color:var(--accent)}.ledger-changes{display:flex;flex-wrap:wrap;gap:9rpx 18rpx;margin-top:12rpx;font-size:20rpx;color:var(--muted)}.lobby-tools{display:flex;justify-content:center;gap:38rpx}.lobby-tools button{font-size:23rpx;padding:18rpx}.lobby-footnote{font-size:19rpx;color:var(--muted);line-height:1.9;text-align:center;padding:10rpx 10rpx 20rpx}.lobby-error{color:var(--danger);font-size:23rpx;line-height:1.8;margin:18rpx 0}.lobby-footer{flex:none;background:var(--surface);border-top:1rpx solid var(--line);padding:15rpx 24rpx calc(18rpx + env(safe-area-inset-bottom))}.lobby-footer>view{text-align:center;font-size:19rpx;color:var(--muted);margin-bottom:10rpx}.lobby-footer button{width:100%;font-size:28rpx;min-height:86rpx}

.lobby-screen .full{display:block;min-width:0;width:100%;margin:0}.lobby-screen .setup-actions .primary,.lobby-screen .setup-actions .outline,.lobby-screen .next-options .primary,.lobby-screen .next-options .outline{width:0;min-width:0;flex:1;margin:0}.lobby-screen .tenpai-options .chip{width:0;min-width:0;flex:1 0 44%;margin:0}.lobby-screen .lobby-footer .primary{width:100%;min-width:0;margin:0}

.lobby-screen .undo-button{display:block;width:100%;min-width:0;margin:16rpx 0 0;padding:15rpx 0;font-size:21rpx}
