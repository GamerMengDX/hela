.title{font-size:40rpx}.clear-history{margin-top:22rpx;text-align:left;padding-left:0}.record-card{padding:27rpx}.record-date{display:flex;align-items:center;justify-content:space-between;color:var(--muted);font-size:19rpx;letter-spacing:1rpx;margin-bottom:25rpx}.record-tiles{display:flex;gap:11rpx 8rpx;align-items:center;flex-wrap:wrap;padding:22rpx 18rpx;background:var(--surface);border-radius:12rpx}.record-meld{display:flex;align-items:center;gap:7rpx;padding-left:9rpx;border-left:1rpx dashed var(--line)}.record-details{margin-top:24rpx;font-size:25rpx;color:var(--muted)}.record-details .caption{font-size:19rpx;line-height:1.9;margin-top:9rpx}.record-bottom{margin-top:22rpx}.record-points{font-family:Georgia,serif;font-size:50rpx;color:var(--accent)}.record-points text{font-size:21rpx;margin-left:8rpx;color:var(--muted)}.record-bottom button{font-size:21rpx}.record-bottom .outline{padding:14rpx 21rpx}
