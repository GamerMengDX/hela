<view class="app-shell theme-{{themeId}} locale-{{locale}}">
<app-header caption="{{copy.hand_history}}" />
<view class="page"><view class="page-header"><text class="eyebrow">{{copy.eyebrow_history}}</text><view class="title">{{copy.keep_every_hand_you_have_figured_out}}</view><view class="subtitle">{{copy.history_stays_on_this_device_tap_a_hand}}</view><button wx:if="{{records.length}}" class="text-button danger clear-history" bindtap="onClear">{{copy.clear_history}}</button></view><view wx:if="{{!records.length}}" class="card empty"><view class="empty-title">{{copy.your_first_saved_hand_starts_here}}</view><view class="empty-description">{{copy.after_calculating_tap_save_this_hand_to_keep}}</view><button class="primary" bindtap="onStart">{{copy.start_calculating}}</button></view><view wx:for="{{records}}" wx:key="id" class="card record-card"><view class="record-date"><text>{{copy.record_hand_prefix}}{{item.number}}</text><text>{{item.date}}</text></view><view class="record-tiles"><mahjong-tile wx:for="{{item.tiles}}" wx:for-item="tile" wx:key="index" tile="{{tile.tile}}" size="small"/><view class="record-meld" wx:for="{{item.melds}}" wx:for-item="meld" wx:key="index"><mahjong-tile wx:for="{{meld.tiles}}" wx:for-item="tile" wx:key="index" tile="{{tile.tile}}" size="tiny"/></view></view><view class="record-details"><view>{{item.wind}}{{copy.seat_2}}{{item.method}}</view><view class="caption">{{item.yaku}}</view></view><view class="row record-bottom"><text class="record-points">{{item.points}}<text>{{copy.points}}</text></text><view class="button-row"><button class="outline" data-index="{{item.index}}" bindtap="onLoadHand">{{copy.load_again}}</button><button class="text-button danger" data-index="{{item.index}}" bindtap="onDelete">{{copy.delete}}</button></view></view></view><view class="local-note">{{copy.keeps_the_latest_30_hands_clearing_app_data}}</view></view>

</view>
