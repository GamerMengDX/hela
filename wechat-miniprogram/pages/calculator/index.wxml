<view class="app-shell fixed-shell theme-{{themeId}} locale-{{locale}}">
<view class="calculator-screen">
  <view class="calculator-header"><app-header caption="{{copy.score_calculator}}" calculator-help="{{true}}" bind:help="onHeaderHelp" /></view>
  <view wx:if="{{localTable}}" class="local-table-banner"><view>{{tableError || tableLabel + copy.local_table}}<text>{{tableSettled ? copy.hand_settled : copy.select_the_winner_s_seat_wind_then_confirm}}</text></view><button bindtap="onLocalLobby">{{copy.return_to_lobby}}</button></view>
  <view class="step-bar">
    <button wx:for="{{steps}}" wx:key="index" class="step-tab {{step === item.index ? 'active' : ''}}" data-step="{{item.index}}" bindtap="onStep" aria-pressed="{{step === item.index}}"><text class="step-number">{{item.index + 1}}</text>{{item.name}}</button>
  </view>
  <view class="workspace">
    <swiper class="step-swiper" current="{{step}}" bindchange="onStepSwipe" duration="220">
      <swiper-item>
        <scroll-view class="panel-scroll" scroll-y enhanced show-scrollbar="{{false}}">
          <view class="panel hand-panel">
            <view class="entry-intro"><view><text class="entry-title">{{copy.enter_a_hand}}</text><text class="entry-subtitle">{{open ? copy.open_hand : copy.closed_hand}}</text></view><view class="entry-count">{{state.hand.length}}<text> / {{expected}}</text></view></view>
            <view class="entry-tray"><view class="tray-labels"><text>{{copy.hand}}</text><text class="tray-caption">{{copy.tap_to_remove_hold_to_select_winning_tile}}</text><text>{{copy.winning_tile}}</text></view><view class="hand-board"><view class="concealed-tiles"><view wx:for="{{handSlots}}" wx:key="slot" class="entry-slot"><mahjong-tile wx:if="{{item.tile}}" tile="{{item.tile}}" size="entry" data-index="{{item.index}}" bind:pick="onRemoveHand" bind:choosewin="onSelectWin"/><view wx:else class="empty-tile">·</view></view></view><view class="winning-slot"><mahjong-tile wx:if="{{complete}}" tile="{{winTile}}" size="entry" selected="{{true}}" data-index="{{state.winIndex}}" bind:pick="onRemoveHand"/><view wx:else class="last-tile">{{copy.last}}<view>{{copy.enter}}</view></view></view></view></view>
            <view class="entry-actions"><button class="entry-control photo-entry" bindtap="onPhoto"><view class="camera-action-icon"/>{{copy.photo_recognition}}</button><button class="entry-control undo-entry" bindtap="onUndo" disabled="{{!canUndo}}" aria-label="{{copy.undo_last_action}}">↶</button><button class="entry-control clear-entry" bindtap="onClear">{{copy.clear}}</button></view>
            <view class="entry-editor"><view class="entry-editor-heading"><text>{{copy.choose_tiles}}</text><view class="red-five-toggle"><text>{{copy.red_five}}</text><switch checked="{{redFive}}" disabled="{{currentSuit === 'z'}}" bindchange="onRedFive" color="{{themeAccent}}" /></view></view><view class="entry-keyboard-layout"><view class="entry-keyboard"><view class="entry-suits"><button wx:for="{{suits}}" wx:key="id" class="entry-suit {{currentSuit === item.id ? 'selected' : ''}}" data-suit="{{item.id}}" bindtap="onSuit">{{item.name}}</button></view><view class="entry-grid"><view wx:for="{{keyboardTiles}}" wx:key="tile" class="entry-key"><mahjong-tile tile="{{item.tile}}" size="keypad" disabled="{{item.disabled}}" bind:pick="onAddTile"/><text wx:if="{{item.count}}" class="key-count">{{item.count}}/4</text></view></view></view><view class="entry-utilities"><button class="entry-utility" bindtap="onOpenMeld"><text class="utility-icon">▥　›</text><text>{{copy.melds_and_kans}}</text><text class="utility-note">{{melds.length}}{{copy.melds}}</text></button><button class="entry-utility" bindtap="onOpenIndicators"><text class="utility-icon">☆　›</text><text>{{copy.dora_indicators}}</text><text class="utility-note">{{dora.length}}{{copy.tiles}}</text></button></view></view><view class="entry-hint"><button bindtap="onTextMode">{{copy.notation_input}}</button><text>{{complete ? copy.hand_complete : copy.missing + missingTiles + copy.tiles}}</text></view></view>
          </view>
        </scroll-view>
      </swiper-item>
      <swiper-item>
        <scroll-view class="panel-scroll" scroll-y enhanced show-scrollbar="{{false}}">
          <view class="panel context-panel">
            <view class="panel-heading"><text class="panel-title">{{copy.round_conditions}}</text><button class="text-button" data-modal="rules" bindtap="onOpenSheet">{{copy.rules}}</button></view>
            <view wx:if="{{localTable}}" class="table-roster"><text wx:for="{{tableNames}}" wx:key="index">{{winds[index].name}} · {{item}}</text></view>
            <view class="context-card">
              <view class="context-grid"><view><text class="field-label">{{copy.round_wind}}</text><view class="wind-options"><button wx:for="{{winds}}" wx:key="value" class="chip {{state.round === item.value ? 'selected' : ''}}" data-field="round" data-value="{{item.value}}" bindtap="onField">{{item.name}}</button></view></view><view><text class="field-label">{{copy.seat_wind}}<text class="caption">{{state.seat === 0 ? copy.dealer : copy.non_dealer}}</text></text><view class="wind-options"><button wx:for="{{winds}}" wx:key="value" class="chip {{state.seat === item.value ? 'selected' : ''}}" data-field="seat" data-value="{{item.value}}" bindtap="onField">{{item.name}}</button></view></view><view><text class="field-label">{{copy.win_method}}</text><view class="method-options"><button class="chip {{state.method === 'ron' ? 'selected' : ''}}" data-field="method" data-value="ron" bindtap="onField">{{copy.ron}}</button><button class="chip {{state.method === 'tsumo' ? 'selected' : ''}}" data-field="method" data-value="tsumo" bindtap="onField">{{copy.tsumo}}</button></view></view><view><text class="field-label">{{state.method === 'ron' ? copy.discarder : copy.payment}}</text><picker wx:if="{{state.method === 'ron'}}" range="{{loserNames}}" value="{{loserIndex}}" bindchange="onLoser"><view class="picker-field">{{loserNames[loserIndex]}} <text>⌄</text></view></picker><view wx:else class="picker-field muted">{{copy.the_other_three_players_each_pay}}</view></view></view>
            </view>
            <view class="context-card"><view class="row"><text class="field-label">{{copy.riichi}}</text><view class="ippatsu"><text>{{copy.ippatsu}}</text><switch checked="{{state.ippatsu}}" disabled="{{ippatsuDisabled}}" bindchange="onIppatsu" color="{{themeAccent}}" /></view></view><view class="riichi-options"><button class="chip {{state.riichi === 0 ? 'selected' : ''}}" data-field="riichi" data-value="0" bindtap="onField">{{copy.no_riichi_2}}</button><button class="chip {{state.riichi === 1 ? 'selected' : ''}}" data-field="riichi" data-value="1" bindtap="onField" disabled="{{open}}">{{copy.riichi}}</button><button class="chip {{state.riichi === 2 ? 'selected' : ''}}" data-field="riichi" data-value="2" bindtap="onField" disabled="{{open}}">{{copy.double_riichi}}</button></view><view wx:if="{{open}}" class="field-note">{{copy.riichi_is_unavailable_after_chi_pon_or_open}}</view></view>
            <view class="context-card"><text class="field-label">{{copy.situational_yaku}}<text class="caption">{{copy.choose_according_to_the_actual_round}}</text></text><view class="special-grid"><button wx:for="{{specials}}" wx:key="type" class="special-option {{item.selected ? 'selected' : ''}}" disabled="{{item.disabled}}" data-type="{{item.type}}" bindtap="onSpecial"><view class="row"><text>{{item.name}}</text><text class="selection-circle">{{item.selected ? '✓' : ''}}</text></view><view class="caption">{{item.description}}</view></button></view></view>
            <view class="context-card bonus-card"><button class="fold-button" bindtap="onToggleBonus" aria-expanded="{{bonusExpanded}}"><text>{{copy.honba_and_deposits}}</text><text class="fold-value">{{state.honba}}{{copy.honba_3}}{{state.sticks}} {{copy.sticks}} {{bonusExpanded ? '⌃' : '⌄'}}</text></button><view class="context-grid bonus-fields" wx:if="{{bonusExpanded}}"><view><text class="field-label">{{copy.honba}}<text class="caption">{{copy.label_300_points_per_honba}}</text></text><view class="stepper"><button data-field="honba" data-delta="-1" bindtap="onCount">−</button><input type="number" value="{{state.honba}}" maxlength="2" data-field="honba" bindblur="onCountInput" /><text>{{copy.honba_2}}</text><button data-field="honba" data-delta="1" bindtap="onCount">＋</button></view></view><view><text class="field-label">{{copy.deposits}}<text class="caption">{{copy.label_1_000_points_per_stick}}</text></text><view class="stepper"><button data-field="sticks" data-delta="-1" bindtap="onCount">−</button><input type="number" value="{{state.sticks}}" maxlength="2" data-field="sticks" bindblur="onCountInput" /><text>{{copy.sticks}}</text><button data-field="sticks" data-delta="1" bindtap="onCount">＋</button></view></view></view></view>
          </view>
        </scroll-view>
      </swiper-item>
      <swiper-item>
        <scroll-view class="panel-scroll" scroll-y enhanced show-scrollbar="{{false}}">
          <view class="panel result-panel">
            <view class="panel-heading"><text class="panel-title">{{copy.score_result}}</text><text class="caption">{{result.ok ? copy.valid_winning_hand : copy.check_the_entered_hand}}</text></view>
            <block wx:if="{{result.ok}}">
              <view class="score-hero"><view class="row"><text>{{result.role}} · {{result.method}}{{copy.hand_points}}</text><text class="limit">{{result.isBasic ? copy.below_mangan : result.limit}}</text></view><view class="score-line"><view class="score-points">{{result.points}}<text>{{copy.points}}</text></view><view class="han-fu" wx:if="{{!result.yakuman}}">{{result.han}}<text>{{copy.han}}</text><view>{{result.fu}}<text>{{copy.fu}}</text></view></view><text wx:else class="yakuman-label">{{result.limit}}</text></view></view>
              <view class="result-card"><view class="row"><text class="field-label">{{copy.yaku_in_this_hand}}</text><text class="caption">{{copy.tap_to_view_conditions}}</text></view><view class="yaku-chips"><button wx:for="{{result.yaku}}" wx:key="key" class="yaku-chip" data-key="{{item.key}}" bindtap="onYaku"><text>{{item.name}}</text><text>{{item.label}} ›</text></button></view><button class="fu-toggle full" bindtap="onToggleFu">{{result.yakuman ? copy.yakuman_points : result.fu + copy.fu_2}}{{copy.scoring_breakdown}}<text>{{copy.view_explanation}}</text></button></view>
              <view class="result-card payment-card"><text class="field-label">{{copy.payments}}</text><view class="payment-row" wx:for="{{result.payments}}" wx:key="wind"><view class="payment-wind"><text class="wind-avatar">{{item.wind}}</text><text>{{item.wind}}{{copy.seat}}</text><text class="caption" wx:if="{{item.dealer}}">{{copy.dealer}}</text></view><text class="payment-points">{{item.amount}}<text>{{copy.points}}</text></text></view><view class="field-note" wx:if="{{state.honba || state.sticks}}">{{copy.includes_2}}{{state.honba}} {{copy.honba_2}}{{state.sticks ? copy.add_deposits + result.deposit + copy.points_2 : ''}}</view><view class="row total-row"><text>{{localTable ? tableNames[state.seat] + copy.total_received_2 : copy.total_received}}</text><text class="total-points">{{result.total}}<text>{{copy.points}}</text></text></view></view>
            </block>
            <view wx:else class="result-card empty"><view class="empty-title">{{result.title}}</view><view class="empty-description">{{result.message}}</view><button class="outline full" bindtap="onEditInput">{{result.code === 'no-yaku' ? copy.check_round_conditions : copy.return_to_hand_entry}}</button><button class="text-button" data-modal="examples" bindtap="onOpenSheet">{{copy.try_a_teaching_example}}</button></view>
            <view wx:if="{{localTable}}" class="local-winner-info">{{copy.winner}}{{tableNames[state.seat]}} · {{state.method === 'ron' ? tableNames[state.loser] + copy.discards : copy.the_other_three_players_pay}}<view>{{tableSettled ? copy.this_hand_is_settled_return_to_the_lobby : copy.check_the_points_then_confirm_settlement_below}}</view></view><view class="result-note">{{copy.scores_update_as_you_type_calculations_and_history}}</view>
          </view>
        </scroll-view>
      </swiper-item>
    </swiper>
  </view>
  <view class="calculator-footer">
    <block wx:if="{{step === 0}}"><button class="primary next-button" disabled="{{!complete}}" bindtap="onNext">{{copy.next_round_conditions}}</button></block>
    <block wx:elif="{{step === 1}}"><button class="footer-secondary" bindtap="onPrevious">{{copy.edit_hand}}</button><button class="primary next-button" bindtap="onCalculate">{{copy.view_result}}</button></block>
    <block wx:else><button class="footer-secondary" bindtap="onPrevious">{{copy.edit_round}}</button><button wx:if="{{result.ok && !localTable}}" class="footer-copy" bindtap="onCopy">{{copy.copy}}</button><button wx:if="{{result.ok && localTable}}" class="primary next-button" disabled="{{tableExpired || tableSettled}}" bindtap="onSettle">{{tableSettled ? copy.hand_settled : copy.confirm_settlement_transfer_points}}</button><button wx:elif="{{result.ok}}" class="primary next-button" bindtap="onSave">{{copy.save_this_hand}}</button><button wx:else class="primary next-button" bindtap="onEditInput">{{result.code === 'no-yaku' ? copy.check_round_conditions : copy.complete_hand_details}}</button></block>
  </view>
</view>

<view class="modal-backdrop" wx:if="{{modal}}" bindtap="onCloseSheet"><view class="sheet" catchtap="noop"><view class="sheet-header"><text class="sheet-title">{{modal === 'indicators' ? copy.dora_indicators : modal === 'notation' ? copy.notation_input : modal === 'meld' ? copy.melds_and_kans : modal === 'examples' ? copy.start_practicing_with_a_winning_hand : modal === 'rules' ? copy.your_table_your_rules : modal === 'help' ? copy.score_a_hand_in_three_steps : modal === 'fu' ? (result.yakuman ? copy.yakuman_scoring : result.fu + copy.fu_breakdown_2) : activeYaku.name}}</text><button class="sheet-close" bindtap="onCloseSheet">×</button></view><scroll-view class="sheet-scroll" scroll-y>
  <block wx:if="{{modal === 'examples'}}"><view aria-role="button" aria-label="{{item.name}}" class="example-row" wx:for="{{examples}}" wx:key="name" data-index="{{index}}" bindtap="onExample"><view>{{item.name}}</view><text class="caption">{{item.desc}}</text></view></block>
  <block wx:elif="{{modal === 'rules'}}"><view class="sheet-description">{{copy.four_player_riichi_one_red_five_per_suit}}</view><view class="rule-row" wx:for="{{ruleRows}}" wx:key="key"><view><text>{{item.name}}</text><view class="caption">{{item.description}}</view></view><switch checked="{{item.value}}" color="{{themeAccent}}" data-key="{{item.key}}" bindchange="onRuleChange"/></view><view class="field-note">{{copy.scoring_engine_majiang_core_1_4_1_mit}}</view></block>
  <block wx:elif="{{modal === 'help'}}"><view class="help-step"><text>{{copy.label_01_enter_the_hand}}</text><view>{{copy.tap_a_tab_or_swipe_between_hand_round}}</view></view><view class="help-step"><text>{{copy.label_02_set_the_conditions}}</text><view>{{copy.set_round_wind_seat_wind_and_ron_or}}</view></view><view class="help-step"><text>{{copy.label_03_understand_the_score}}</text><view>{{copy.tap_a_yaku_for_its_conditions_and_open}}</view></view></block>
  <block wx:elif="{{modal === 'fu'}}"><view class="sheet-description">{{result.yakuman ? copy.yakuman_uses_fixed_points_instead_of_han_and : copy.this_breakdown_uses_the_highest_scoring_interpretation_of}}</view><view class="fu-list"><view class="row" wx:for="{{result.fuDetails}}" wx:key="name"><text>{{item.name}}</text><text>{{item.fu === null ? '—' : item.fu + copy.fu_2}}</text></view></view></block>
  <block wx:elif="{{modal === 'yaku'}}"><view class="badge">{{activeYaku.label}} · {{activeYaku.kind}}</view><view class="yaku-description">{{activeYaku.description}}</view></block>
  <block wx:elif="{{modal === 'notation'}}"><view class="notation-form"><input class="input" value="{{notationInput}}" bindinput="onNotationInput" placeholder="234m34566p45667s8s" maxlength="80" confirm-type="done" bindconfirm="onApplyNotation"/><view class="field-note">{{copy.m_characters_p_circles_s_bamboo_z_honors}}</view><button class="primary full" bindtap="onApplyNotation">{{copy.confirm_entry}}</button></view></block>
  <block wx:elif="{{modal === 'indicators'}}"><view class="chips"><button class="chip {{target === 'dora' ? 'selected' : ''}}" data-target="dora" bindtap="onTarget">{{copy.dora_indicators}}</button><button class="chip {{target === 'ura' ? 'selected' : ''}}" data-target="ura" bindtap="onTarget" disabled="{{!state.riichi}}">{{copy.ura_dora_indicators}}</button></view><view class="indicators indicator-sheet"><mahjong-tile wx:for="{{target === 'dora' ? dora : ura}}" wx:key="index" tile="{{item.tile}}" size="small" removable="{{true}}" data-index="{{item.index}}" data-target="{{target}}" bind:remove="onRemoveIndicator"/><text wx:if="{{target === 'dora' ? !dora.length : !ura.length}}" class="field-note">{{copy.choose_the_revealed_indicators_below}}</text></view><view class="actual-dora" wx:if="{{target === 'dora' && dora.length}}"><text>{{copy.actual_dora}}</text><mahjong-tile wx:for="{{dora}}" wx:key="index" tile="{{item.actual}}" size="tiny"/></view><view class="indicator-palette"><view class="palette-row" wx:for="{{paletteRows}}" wx:key="key" wx:for-item="row"><text class="suit-label">{{row.label}}</text><view class="palette-tiles"><mahjong-tile wx:for="{{row.tiles}}" wx:key="tile" tile="{{item.tile}}" size="small" disabled="{{item.disabled}}" bind:pick="onAddTile"/></view></view></view><view class="field-note">{{copy.up_to_five_indicators_actual_dora_is_calculated}}</view></block>
  <block wx:elif="{{modal === 'meld'}}"><view class="saved-meld" wx:for="{{melds}}" wx:key="index"><text>{{item.label}}</text><view class="meld-tiles"><mahjong-tile wx:for="{{item.tiles}}" wx:key="index" tile="{{item.tile}}" size="tiny"/></view><button class="text-button" data-index="{{item.index}}" bindtap="onRemoveMeld">{{copy.remove}}</button></view><view class="chips"><button wx:for="{{meldTypes}}" wx:key="type" class="chip {{meldType === item.type ? 'selected' : ''}}" data-type="{{item.type}}" bindtap="onMeldType">{{item.name}}</button></view><view class="meld-draft"><mahjong-tile wx:for="{{meldTiles}}" wx:key="index" tile="{{item.tile}}" size="meld" removable="{{true}}" data-index="{{item.index}}" bind:remove="onMeldRemove"/><text class="caption">{{copy.selected}}{{meldTiles.length}} / {{meldRequired}}{{copy.tiles}}</text></view><view class="palette-row" wx:for="{{meldPalette}}" wx:key="key" wx:for-item="row"><text class="suit-label">{{row.label}}</text><view class="palette-tiles"><mahjong-tile wx:for="{{row.tiles}}" wx:key="tile" tile="{{item.tile}}" size="small" bind:pick="onMeldTile"/></view></view><view class="divider"></view><view class="row"><text class="field-label">{{copy.meld_source}}</text><picker range="{{directionNames}}" value="{{directionIndex}}" bindchange="onMeldDirection" disabled="{{meldType === 'chi' || meldType === 'ankan'}}"><view class="picker-field">{{meldType === 'ankan' ? copy.closed_kan_has_no_source : directionNames[directionIndex]}} ⌄</view></picker></view><view class="row move-row"><text>{{copy.move_these_tiles_out_of_the_entered_hand}}</text><switch checked="{{meldMove}}" bindchange="onMeldMove" color="{{themeAccent}}"/></view><view class="meld-error">{{meldError}}</view><button class="primary full" disabled="{{state.melds.length >= 4}}" bindtap="onConfirmMeld">{{copy.add_this_meld}}</button></block>
</scroll-view><button wx:if="{{modal === 'rules' || modal === 'help' || modal === 'yaku' || modal === 'fu' || modal === 'indicators'}}" class="primary full sheet-done" bindtap="onCloseSheet">{{copy.done}}</button></view></view>

</view>
