page{height:100%;overflow:hidden}.photo-screen{height:100vh;display:flex;flex-direction:column;background:var(--surface)}.photo-header{padding:24rpx 28rpx 20rpx;flex:none;border-bottom:1rpx solid var(--line)}.photo-title{font-family:var(--heading-font);font-size:37rpx;font-weight:600;margin:9rpx 0}.photo-subtitle{font-size:20rpx;color:var(--muted)}.photo-body{flex:1;min-height:0;height:0}.photo-content{padding:24rpx 28rpx}.capture-guide{text-align:center;background:var(--surface);border:1rpx solid var(--line);border-radius:19rpx;padding:62rpx 26rpx 40rpx}.camera-symbol{position:relative;width:119rpx;height:83rpx;border:3rpx solid var(--line);border-radius:15rpx;margin:8rpx auto 32rpx;display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:68rpx;line-height:1}.camera-symbol>view{position:absolute;width:41rpx;height:13rpx;background:var(--surface);border-radius:4rpx 4rpx 0 0;top:-15rpx;left:21rpx}.capture-title{font-size:28rpx;color:var(--accent);font-weight:500}.capture-description{font-size:23rpx;color:var(--muted);line-height:1.9;margin-top:18rpx}.capture-description>view{font-size:21rpx;margin-top:6rpx}.capture-example{display:flex;align-items:center;justify-content:center;gap:11rpx;margin-top:38rpx;padding:24rpx;border-radius:12rpx;background:var(--surface)}.capture-example>text{color:var(--muted);margin:0 9rpx}.photo-preview{height:240rpx;position:relative;border-radius:13rpx;background:var(--surface);border:1rpx solid var(--line);overflow:hidden}.photo-preview>image{width:100%;height:100%;display:block}.photo-preview>text{position:absolute;bottom:0;left:0;right:0;text-align:center;padding:7rpx;background:var(--surface);color:var(--muted);font-size:17rpx}.recognition-progress{display:flex;gap:13rpx;align-items:center;justify-content:center;font-size:24rpx;color:var(--muted);padding:34rpx 0}.loading-dot{width:13rpx;height:13rpx;border-radius:50%;background:var(--surface);animation:pulse 1s infinite}@keyframes pulse{50%{opacity:.3}}.photo-error,.validation-note{background:var(--surface);border:1rpx solid var(--line);border-radius:10rpx;padding:18rpx;color:var(--danger);font-size:22rpx;line-height:1.8;margin-top:20rpx}.review-heading{display:flex;align-items:center;justify-content:space-between;margin:23rpx 0 13rpx;font-size:25rpx;color:var(--accent)}.review-heading>view{display:flex;align-items:center;gap:16rpx}.review-count{font-size:19rpx;color:var(--muted)}.photo-screen .text-button{width:auto;margin:0;padding:7rpx 0;font-size:21rpx}.review-modes{display:flex;gap:9rpx;background:var(--surface);padding:5rpx;border:1rpx solid var(--line);border-radius:10rpx}.review-modes button{width:auto;flex:1;margin:0;padding:13rpx 6rpx;background:none;color:var(--muted);font-size:22rpx}.review-modes button.selected{background:var(--surface);color:var(--accent);box-shadow:0 2rpx 8rpx var(--shadow)}.review-instruction{font-size:18rpx;color:var(--muted);margin:13rpx 0 18rpx}.review-grid{display:flex;flex-wrap:wrap;gap:13rpx 0;justify-content:flex-start}.review-cell{width:14.285%;display:flex;flex-direction:column;align-items:center;border-radius:10rpx;padding:8rpx 0 5rpx;gap:9rpx}.review-cell.uncertain{background:var(--surface)}.review-number{font:20rpx Georgia,serif;color:var(--muted);line-height:1}.review-name{font-size:18rpx;color:var(--muted);line-height:1.5}.review-tag{min-height:25rpx;font-size:16rpx;color:var(--muted);line-height:1.5}.review-note{font-size:20rpx;color:var(--muted);line-height:1.9;margin:20rpx 0 10rpx}.review-note>view{font-size:18rpx;color:var(--muted);margin-top:8rpx}.photo-footer{flex:none;padding:19rpx 28rpx calc(17rpx + env(safe-area-inset-bottom));background:var(--surface);border-top:1rpx solid var(--line)}.source-buttons{display:flex;gap:13rpx}.source-buttons button{width:auto;flex:1;margin:0;padding:20rpx 8rpx;font-size:24rpx}.photo-footer .import-button{width:100%;margin:14rpx 0 0;padding:21rpx 15rpx;font-size:24rpx}.vision-canvas{position:fixed;left:-2000px;top:-2000px;width:1px;height:1px;pointer-events:none}.candidate-section>text{font-size:21rpx;color:var(--muted)}.candidate-buttons{display:flex;gap:16rpx;margin:17rpx 0 24rpx}.candidate-buttons button{width:auto;flex:1;display:flex;align-items:center;justify-content:center;gap:11rpx;margin:0;padding:15rpx 6rpx;border:1rpx solid var(--line);background:var(--surface);color:var(--muted);font-size:20rpx}.photo-palette-row{display:flex;align-items:center;gap:8rpx;margin-bottom:17rpx}.photo-palette-row>text{width:38rpx;flex-shrink:0;font-size:18rpx;color:var(--muted)}.photo-palette-row>view{flex:1;min-width:0;display:flex;gap:6rpx;flex-wrap:wrap}.sheet .sheet-close{width:48rpx;margin:0}.privacy-backdrop{z-index:110}.privacy-description{font-size:24rpx;line-height:1.9;color:var(--muted);margin:25rpx 0}.sheet .privacy-contract{width:auto;margin:0 0 28rpx;text-align:left;padding:0;font-size:23rpx;color:var(--accent)}

.photo-screen .demo-photo-button{margin:23rpx auto 0;font-size:21rpx;padding:9rpx 5rpx}
.model-loading-note{margin-top:18rpx;padding:13rpx 17rpx;border:1rpx solid var(--line);border-radius:9rpx;background:var(--surface);color:var(--accent);font-size:24rpx;line-height:1.6}
.meld-group-actions{display:flex;align-items:center;gap:6rpx}.photo-screen .meld-review-top .group-order{min-width:62rpx;padding:15rpx 8rpx;font-size:29rpx}

.photo-correction-sheet .sheet-close{width:88rpx;height:88rpx;min-height:88rpx;flex:none;padding:0;display:flex;align-items:center;justify-content:center;border:1rpx solid var(--line);border-radius:50%;background:var(--surface);color:var(--text);font-size:40rpx}
.correction-toolbar{display:flex;align-items:center;justify-content:space-between;color:var(--muted);font-size:22rpx;margin:10rpx 0 16rpx}.correction-red{display:flex;align-items:center;gap:6rpx;min-height:88rpx}.correction-red switch{transform:scale(.75);transform-origin:right center}
.correction-keyboard{padding:16rpx;border:1rpx solid var(--line);border-radius:var(--radius);background:var(--keyboard-panel)}.correction-suits{display:flex;gap:6rpx;margin-bottom:14rpx}.photo-correction-sheet .correction-suit{width:auto;flex:1;margin:0;padding:18rpx 0;min-height:72rpx;line-height:1.3;border-radius:11rpx;background:none;color:var(--keyboard-text);font-size:23rpx}.photo-correction-sheet .correction-suit.selected{background:var(--selected);color:var(--selected-ink)}
.correction-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10rpx}.photo-correction-sheet .correction-key{display:flex;align-items:center;justify-content:center;width:100%;min-height:112rpx;margin:0;padding:11rpx;border:1rpx solid var(--line);border-radius:14rpx;background:var(--surface)}.photo-correction-sheet .correction-key.selected{border-color:var(--keyboard-text);background:var(--selected)}.correction-key image{display:block;width:64rpx;height:90rpx}.photo-correction-sheet .candidate-section{margin-top:24rpx}.photo-correction-sheet .move-tile-button{margin-bottom:8rpx}

.meld-review-heading{margin-top:30rpx;border-top:1rpx solid var(--line);padding-top:24rpx}.meld-review-note{font-size:21rpx;line-height:1.8;color:var(--muted);margin:16rpx 0}.meld-review-card{margin-top:20rpx;padding:18rpx;background:var(--surface);border:2rpx solid var(--line);border-radius:13rpx}.meld-review-card.excluded{opacity:.6}.meld-review-top{display:flex;justify-content:space-between;align-items:center}.meld-review-top label{display:flex;align-items:center;gap:5rpx;font-size:25rpx;color:var(--accent)}.meld-review-top switch{transform:scale(.65);transform-origin:left center;margin-right:-28rpx}.photo-screen .meld-review-top button{padding:15rpx 12rpx;color:var(--muted);min-height:72rpx}.meld-review-fields{display:flex;gap:12rpx;margin:15rpx 0 22rpx}.meld-review-fields picker{flex:1;min-width:0}.meld-picker{display:flex;align-items:center;justify-content:space-between;padding:20rpx 16rpx;border:1rpx solid var(--line);border-radius:9rpx;background:var(--surface);color:var(--accent);font-size:25rpx;min-height:78rpx;box-sizing:border-box}.meld-picker.source-needed{background:var(--surface);border-color:var(--line);color:var(--danger)}.meld-fixed-source{flex:1;font-size:22rpx;align-self:center;color:var(--muted)}.meld-review-tiles{display:flex;gap:20rpx;align-items:center;flex-wrap:wrap;padding:5rpx 0}.meld-review-cell{display:flex;flex-direction:column;align-items:center;gap:9rpx;font-size:22rpx;color:var(--muted)}.photo-screen .meld-add-tile{width:auto;padding:20rpx 15rpx;font-size:24rpx;background:var(--surface);border:1rpx dashed var(--line);color:var(--accent)}.sheet .move-tile-button{width:100%;margin:10rpx 0 24rpx;padding:18rpx;font-size:25rpx}

.review-grid{gap:12rpx 0}.review-cell{gap:8rpx}.photo-screen .review-empty,.photo-screen .review-empty[disabled]{display:flex;align-items:center;justify-content:center;width:88rpx;height:90rpx;min-height:90rpx;margin:0;padding:0;border:1rpx dashed var(--muted);border-radius:10rpx;background:var(--surface);color:var(--accent);font-size:38rpx;line-height:1}.photo-screen .review-empty[disabled]{opacity:.35}.review-missing{font-size:21rpx;color:var(--accent);line-height:1.8;margin-top:10rpx}.review-heading .text-button[disabled]{opacity:.35}.review-cell:active{background:var(--surface)}
