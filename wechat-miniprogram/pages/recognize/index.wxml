<view class="app-shell fixed-shell theme-{{themeId}} locale-{{locale}}">
<app-header caption="{{copy.photo_recognition}}" />
<view class="photo-screen">
  <view class="photo-header"><text class="eyebrow">{{copy.hela_hand_recognition}}</text><view class="photo-title">{{copy.photograph_a_row_enter_a_hand}}</view><text class="photo-subtitle">{{copy.supports_photos_and_default_tile_mahjong_soul_screenshots}}</text><view class="model-loading-note">{{copy.the_model_may_take_a_moment_to_load}}</view></view>
  <scroll-view class="photo-body" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="photo-content">
      <view wx:if="{{!photoPath}}" class="capture-guide"><view class="camera-symbol"><view></view><text>◯</text></view><view class="capture-title">{{copy.clearly_capture_your_own_hand_and_melds}}</view><view class="capture-description">{{copy.for_photos_include_all_tile_faces_in_even}}<view>{{copy.supports_upright_upside_down_and_sideways_tiles_the}}</view></view><view class="capture-example"><mahjong-tile tile="m2" size="hand"/><mahjong-tile tile="m3" size="hand"/><mahjong-tile tile="m4" size="hand"/><text>…</text><mahjong-tile tile="s8" size="hand"/></view></view>
      <view wx:else class="photo-preview" bindtap="onPreview" aria-role="button" aria-label="{{copy.enlarge_original_photo}}"><image src="{{photoPath}}" mode="aspectFit"/><text>{{examplePhoto ? copy.composite_sample_image_tap_to_zoom : copy.tap_to_zoom_and_compare_the_original_photo}}</text></view>
      <button wx:if="{{!photoPath && !busy}}" class="text-button demo-photo-button" bindtap="onExamplePhoto">{{copy.try_sample_image_composite}}</button>
      <view wx:if="{{busy}}" class="recognition-progress"><view class="loading-dot"></view><text>{{progress}}…</text></view>
      <view wx:if="{{error}}" class="photo-error">{{error}}</view><view wx:if="{{recognitionScene && !busy}}" class="review-note">{{recognitionScene}}</view>
      <block wx:if="{{photoPath && !busy}}">
        <view class="review-heading"><view><text>{{copy.hand}} {{enteredTiles}} / {{expected}}</text><text class="review-count">{{capacityText}}</text></view><button class="text-button" bindtap="onAdd" disabled="{{!canAddHand}}">{{copy.add_tile}}</button></view>
        <view class="review-modes"><button class="{{mode === 'correct' ? 'selected' : ''}}" data-mode="correct" bindtap="onMode">{{copy.correct_tiles}}</button><button class="{{mode === 'win' ? 'selected' : ''}}" data-mode="win" bindtap="onMode" disabled="{{!complete}}">{{copy.select_winning_tile}}</button></view>
        <view class="review-instruction">{{mode === 'correct' ? copy.tap_once_to_remove_twice_to_edit_tap : copy.choose_the_winning_tile_the_last_tile_is}}</view>
        <view class="review-grid"><view wx:for="{{reviewSlots}}" wx:key="index" class="review-cell {{item.uncertain && !item.manual ? 'uncertain' : ''}}"><text class="review-number">{{item.number}}</text><button wx:if="{{item.empty}}" class="review-empty" data-index="{{item.index}}" bindtap="onAdd" disabled="{{!canAddHand}}" aria-label="{{copy.add_one_hand_tile}}">＋</button><mahjong-tile wx:else tile="{{item.tile}}" size="review" selected="{{item.winning}}" data-index="{{item.index}}" bind:pick="onReviewTile"/><text class="review-name">{{item.empty ? copy.missing_tile : item.name}}</text><text class="review-tag">{{item.winning ? copy.winning_tile : item.manual ? copy.corrected : item.uncertain ? copy.check_tile : ''}}</text></view></view><view wx:if="{{missingTiles}}" class="review-missing" role="status">{{missingHandText}}</view>
        <view class="review-heading meld-review-heading"><view><text>{{copy.meld_recognition}}</text><text class="review-count">{{reviewMelds.length}}{{copy.candidate_melds}}</text></view><button class="text-button" bindtap="onAddMeld">{{copy.add_meld}}</button></view>
        <view class="review-modes" wx:if="{{meldCount || reviewMelds.length}}"><button class="{{meldMode === 'keep' ? 'selected' : ''}}" data-mode="keep" bindtap="onMeldMode">{{copy.keep_current_melds}}{{meldCount}}{{copy.melds}}</button><button class="{{meldMode === 'replace' ? 'selected' : ''}}" data-mode="replace" bindtap="onMeldMode">{{copy.use_photo_melds}}</button></view>
        <view class="meld-review-note">{{meldMode === 'replace' ? copy.type_and_source_are_filled_automatically_and_can : copy.current_melds_are_kept_add_a_missing_meld}}</view>
        <block wx:if="{{meldMode === 'replace'}}">
          <view class="meld-review-card {{group.include ? '' : 'excluded'}}" wx:for="{{reviewMelds}}" wx:key="index" wx:for-item="group" wx:for-index="groupIndex">
            <view class="meld-review-top"><label><switch checked="{{group.include}}" data-index="{{group.index}}" bindchange="onMeldInclude" color="#28543f"/><text>{{copy.include_meld}}{{group.index + 1}}{{copy.melds}}</text></label><view class="meld-group-actions"><button class="text-button group-order" data-index="{{group.index}}" data-delta="-1" bindtap="onMeldMove" disabled="{{groupIndex === 0}}" aria-label="{{copy.move_meld_earlier}}">↑</button><button class="text-button group-order" data-index="{{group.index}}" data-delta="1" bindtap="onMeldMove" disabled="{{groupIndex === reviewMelds.length - 1}}" aria-label="{{copy.move_meld_later}}">↓</button><button class="text-button" data-index="{{group.index}}" bindtap="onRemoveMeld">{{copy.delete_group}}</button></view></view>
            <view class="meld-review-fields"><picker range="{{meldTypeNames}}" value="{{group.typeIndex}}" data-index="{{group.index}}" bindchange="onMeldType"><view class="meld-picker">{{group.typeName}}<text>⌄</text></view></picker><picker wx:if="{{group.type !== 'chi' && group.type !== 'ankan'}}" range="{{directionNames}}" value="{{group.directionIndex}}" data-index="{{group.index}}" bindchange="onMeldDirection"><view class="meld-picker {{group.sourceUncertain ? 'source-needed' : ''}}">{{group.directionName}} · {{group.sourceTag}}<text>⌄</text></view></picker><view wx:else class="meld-fixed-source">{{group.type === 'chi' ? copy.chi_comes_from_the_left_player : copy.closed_kan_has_no_called_source}}</view></view>
            <view class="meld-review-tiles"><view wx:for="{{group.items}}" wx:key="index" class="meld-review-cell"><button wx:if="{{!item.tile}}" class="review-empty" data-group="{{groupIndex}}" data-slot="{{item.index}}" bindtap="onMeldTile" aria-label="{{copy.add_a_meld_tile}}">＋</button><mahjong-tile wx:else tile="{{item.tile}}" size="review" data-group="{{groupIndex}}" data-slot="{{item.index}}" bind:pick="onMeldTile"/><text>{{item.name}}</text></view><button wx:if="{{group.items.length < group.required}}" class="meld-add-tile" data-index="{{group.index}}" bindtap="onMeldAddTile">{{copy.add_tile}}</button></view>
            <view class="meld-review-note" wx:if="{{group.type !== 'chi' && group.type !== 'ankan'}}">{{group.sourceHint}}</view>
          </view>
          <view class="meld-review-note">{{copy.face_down_and_obscured_tiles_cannot_be_read}}</view>
        </block>
        <view wx:if="{{validation}}" class="validation-note">{{validation}}</view>
        <view class="review-note">{{uncertainCount ? uncertainText : copy.confirm_the_tiles_and_winning_marker_before_importing}}<view>{{importedMeldsText}}</view></view>
      </block>
    </view>
  </scroll-view>
  <view class="photo-footer"><view class="source-buttons"><button class="outline" bindtap="onAlbum" disabled="{{busy}}">{{copy.choose_from_album}}</button><button class="primary" bindtap="onCamera" disabled="{{busy}}">{{photoPath ? copy.retake_photo : copy.photo_recognition}}</button></view><button wx:if="{{photoPath && !busy}}" class="primary import-button" bindtap="onConfirm" disabled="{{!!validation || !reviewItems.length}}">{{copy.checked_import_this_hand}}</button></view>
</view>
<canvas type="2d" id="vision-canvas" class="vision-canvas"/>
<view class="modal-backdrop" wx:if="{{modal}}" bindtap="onCloseSheet"><view class="sheet photo-correction-sheet" catchtap="noop"><view class="sheet-header"><text class="sheet-title">{{correctionTitle}}</text><button class="sheet-close" bindtap="onCloseSheet" aria-label="{{copy.close_correction_panel}}">×</button></view><scroll-view class="sheet-scroll" scroll-y>
  <view class="correction-toolbar"><text>{{copy.choose_a_tile}}</text><view class="correction-red"><text>{{copy.red_five}}</text><switch checked="{{correctionRed}}" disabled="{{correctionSuit === 'z'}}" bindchange="onCorrectionRed" color="{{themeAccent}}"/></view></view>
  <view class="correction-keyboard"><view class="correction-suits"><button wx:for="{{correctionSuits}}" wx:key="id" class="correction-suit {{correctionSuit === item.id ? 'selected' : ''}}" data-suit="{{item.id}}" bindtap="onCorrectionSuit" aria-pressed="{{correctionSuit === item.id}}">{{item.name}}</button></view>
  <view class="correction-grid"><button wx:for="{{correctionTiles}}" wx:key="tile" class="correction-key {{activeTile === item.tile ? 'selected' : ''}}" data-tile="{{item.tile}}" bindtap="onCorrectionKey" aria-label="{{copy.change_to}}{{item.name}}"><image src="{{item.src}}" mode="aspectFit"/></button></view></view>
  <view wx:if="{{candidates.length}}" class="candidate-section"><text>{{copy.possible_tiles}}</text><view class="candidate-buttons"><button wx:for="{{candidates}}" wx:key="tile" data-tile="{{item.tile}}" bindtap="onCandidate"><mahjong-tile tile="{{item.tile}}" size="small"/><text>{{item.name}}</text></button></view></view>
  <button wx:if="{{activeMeldIndex < 0}}" class="outline move-tile-button" bindtap="onMoveToMeld">{{copy.this_is_a_meld_tile_move_to_meld}}</button><button wx:else class="outline move-tile-button" bindtap="onMoveToHand">{{copy.this_is_a_hand_tile_move_to_hand}}</button>
</scroll-view></view></view>
<view class="modal-backdrop privacy-backdrop" wx:if="{{showPrivacy}}"><view class="sheet"><view class="sheet-title">{{copy.camera_and_album_access}}</view><view class="privacy-description">{{copy.used_to_select_photos_and_recognize_tiles_photos}}</view><button class="text-button privacy-contract" bindtap="onPrivacyContract">{{copy.view_privacy_guide}}</button><view class="source-buttons"><button class="outline" bindtap="onPrivacyReject">{{copy.decline}}</button><button id="photo-privacy-agree" class="primary" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="onPrivacyAgree">{{copy.agree_and_continue}}</button></view></view></view>

</view>
