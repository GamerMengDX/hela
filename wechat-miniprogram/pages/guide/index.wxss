.title{font-size:38rpx;line-height:1.7}.guide-tabs{display:flex;gap:9rpx;margin-bottom:22rpx}.guide-tabs button{flex:1;font-size:21rpx;padding:15rpx 0}.guide-search{height:80rpx}.guide-note{font-size:18rpx;color:var(--muted);margin:19rpx 0 27rpx;flex-wrap:wrap}.guide-note button{padding:0;font-size:19rpx}.guide-grid{display:flex;flex-wrap:wrap;gap:20rpx}.guide-card{width:calc(50% - 10rpx);padding:25rpx 22rpx;background:var(--surface);border:1rpx solid var(--line);border-radius:15rpx;display:flex;flex-direction:column;align-items:stretch;min-height:340rpx;box-shadow:0 5rpx 12rpx var(--shadow)}.guide-index{font:27rpx Georgia,serif;color:var(--muted)}.guide-card .badge{font-size:17rpx;padding:6rpx 8rpx;white-space:nowrap}.guide-card .badge.yakuman{background:var(--surface);border:1rpx solid var(--line);color:var(--muted)}.guide-name{font-family:var(--heading-font);font-size:33rpx;line-height:1.6;margin-top:30rpx;color:var(--accent)}.guide-description{font-size:21rpx;color:var(--muted);line-height:1.95;margin-top:15rpx;margin-bottom:27rpx}.guide-kind{font-size:17rpx;letter-spacing:2rpx;color:var(--muted);margin-top:auto}

.guide-path{display:flex;align-items:center;gap:14rpx;color:var(--muted);font-size:21rpx;margin-bottom:24rpx}.guide-path .text-button{width:auto;margin:0;padding:8rpx 0;font-size:21rpx}


.guide-page{padding-bottom:calc(175rpx + env(safe-area-inset-bottom))}.guide-teaching-footer{position:fixed;bottom:0;left:0;right:0;padding:18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));background:var(--solid);border-top:1rpx solid var(--line);z-index:10}.guide-teaching-footer button{display:flex;align-items:center;justify-content:space-between;width:100%;min-height:100rpx;padding:18rpx 24rpx;background:var(--action);color:var(--action-ink);border-radius:var(--radius);text-align:left}.guide-teaching-title{display:block;font-size:26rpx;font-weight:550}.guide-teaching-subtitle{display:block;font-size:20rpx;margin-top:5rpx;opacity:.85}
