<view class="app-shell theme-{{themeId}} locale-{{locale}}">
<app-header caption="{{copy.yaku_handbook}}" />
<view class="page guide-page"><view class="page-header"><text class="eyebrow">{{copy.eyebrow_guide}}</text><view class="title">{{copy.learn_the_yaku_get_closer_to_winning}}</view><view class="subtitle">{{copy.explore_the_conditions_for_each_yaku_from_riichi}}</view></view><view class="guide-tabs"><button wx:for="{{tabs}}" wx:key="key" class="chip {{filter === item.key ? 'selected' : ''}}" data-key="{{item.key}}" bindtap="onFilter">{{item.name}}</button></view><input class="input guide-search" value="{{search}}" bindinput="onSearch" placeholder="{{copy.search_yaku_or_conditions}}" maxlength="40"/><view class="row guide-note"><text>{{copy.label_2_1_han_means_2_han_closed_1}}</text></view><view class="guide-grid"><view aria-role="button" aria-label="{{item.name}}" class="guide-card" wx:for="{{cards}}" wx:key="key" data-key="{{item.key}}" bindtap="onDetail"><view class="row"><text class="guide-index">{{item.index}}</text><text class="badge {{item.canonicalKind === '役满' ? 'yakuman' : ''}}">{{item.han}}</text></view><view class="guide-name">{{item.name}}</view><view class="guide-description">{{item.description}}</view><text class="guide-kind">{{item.kind}}</text></view></view><view wx:if="{{!cards.length}}" class="empty"><view class="empty-title">{{copy.no_matching_yaku}}</view><view class="empty-description">{{copy.try_riichi_sequence_or_pair}}</view></view><view class="local-note">{{copy.han_come_from_yaku_and_dora}}</view></view>
<view class="guide-teaching-footer"><button bindtap="onExamples"><view><text class="guide-teaching-title">{{copy.learn_by_example_try_it_yourself}}</text><text class="guide-teaching-subtitle">{{copy.label_30_complete_hands_to_explore_and_build_yourself}}</text></view><text>↗</text></button></view>
</view>
