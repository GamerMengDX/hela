.home-page{padding:26rpx 34rpx 38rpx}.home-intro{margin:18rpx 0 44rpx}.home-intro .eyebrow{font-size:18rpx;letter-spacing:2rpx}.home-title{font:500 49rpx/1.5 var(--heading-font);letter-spacing:1rpx;margin:18rpx 0 14rpx}.home-subtitle{color:var(--muted);font-size:22rpx;line-height:1.8}.home-page .home-feature{width:100%;padding:34rpx;text-align:left;background:var(--surface);color:var(--text);border:1rpx solid var(--line);border-radius:var(--radius);margin-bottom:22rpx;white-space:normal;box-shadow:0 5rpx 15rpx var(--shadow)}.home-page .feature-main{display:flex;align-items:center;justify-content:space-between;min-height:320rpx}.feature-index{font-size:17rpx;letter-spacing:2rpx;color:var(--muted)}.feature-title{font:500 44rpx/1.5 var(--heading-font);margin:23rpx 0 28rpx}.feature-link{font-size:22rpx;color:var(--accent)}.home-tiles{position:relative;width:162rpx;height:190rpx;flex-shrink:0}.home-tile-back,.home-tile-front{position:absolute;top:25rpx;left:9rpx;transform:rotate(-14deg)}.home-tiles .home-tile-front{left:69rpx;top:47rpx;transform:rotate(12deg)}.home-page .feature-guide{display:flex;align-items:center;gap:24rpx;padding-top:30rpx;padding-bottom:30rpx}.guide-symbol{font:45rpx serif;color:var(--accent);width:57rpx}.guide-title{font:500 33rpx var(--heading-font);margin-bottom:13rpx}.guide-description{color:var(--muted);font-size:20rpx}.feature-arrow{margin-left:auto;font-size:30rpx;color:var(--muted)}.quick-grid{display:flex;gap:22rpx}.home-page .quick-card{width:0;flex:1;min-width:0;min-height:266rpx;padding:28rpx;margin-bottom:0}.quick-symbol{color:var(--accent);font-size:33rpx}.quick-title{font:500 32rpx var(--heading-font);margin:22rpx 0 14rpx}.quick-description{font-size:20rpx;line-height:1.8;min-height:65rpx;color:var(--muted)}.quick-action{display:block;font-size:18rpx;color:var(--accent);margin-top:15rpx}.home-page .history-link{width:100%;background:none;color:var(--muted);font-size:22rpx;padding:28rpx 10rpx;margin-top:14rpx}

.home-page .feature-main{width:100%;margin-left:0;margin-right:0}.home-page .feature-guide{width:100%;margin-left:0;margin-right:0}.feature-copy{flex:1;min-width:0}

.home-intro{margin:28rpx 0 48rpx}.home-title{font-size:54rpx;font-weight:550;line-height:1.45;margin:22rpx 0 18rpx}.home-subtitle{font-size:24rpx}.home-page .home-feature{padding:38rpx;border-radius:var(--radius);margin-bottom:24rpx}.home-page .feature-main{min-height:352rpx;overflow:hidden}.feature-title{font-size:48rpx;font-weight:550;margin:24rpx 0 32rpx}.feature-link{font-size:23rpx}.home-tiles{width:184rpx;height:220rpx}.home-tile-back{left:6rpx;top:28rpx}.home-tiles .home-tile-front{left:78rpx;top:56rpx}.home-page .feature-guide{gap:28rpx;padding:34rpx 36rpx}.feature-symbol{display:block;width:56rpx;height:74rpx;flex:none}.guide-title{font-size:34rpx;margin-bottom:10rpx}.guide-description{font-size:21rpx}.quick-grid{gap:24rpx}.home-page .quick-card{padding:32rpx 28rpx;min-height:282rpx;margin-bottom:0}.quick-symbol{display:block;width:40rpx;height:40rpx}.quick-title{font-size:34rpx;margin:26rpx 0 14rpx}.quick-description{font-size:21rpx;min-height:68rpx}.quick-action{font-size:19rpx}.home-page .history-link{display:flex;align-items:center;justify-content:center;gap:20rpx;font-size:23rpx;padding:30rpx 10rpx}.history-symbol{display:block;width:30rpx;height:30rpx}

/* Quiet auxiliary control; the visible capsule is 28px high, touch targets stay 44px. */
.home-meta-row{display:flex;align-items:center;gap:8px;min-height:44px}.home-meta-row .eyebrow{flex:1;min-width:0;margin:0;font-size:17rpx;line-height:1.65;letter-spacing:.5rpx}
.language-switch{position:relative;isolation:isolate;display:flex;flex:0 0 158px;width:158px;align-items:center;height:44px;padding:0 2px;margin-left:auto;background:transparent;border:0}
.language-switch::before{content:"";position:absolute;top:8px;bottom:8px;left:0;right:0;z-index:-1;pointer-events:none;border:1rpx solid var(--line);border-radius:999px;background:var(--surface)}
.home-page .language-option{position:relative;isolation:isolate;flex:1;width:0;min-width:0;min-height:44px;padding:0 7px;display:flex;align-items:center;justify-content:center;border:0;border-radius:999px;background:transparent;color:var(--muted);font-size:11px;line-height:1.4;white-space:nowrap}
.home-page .language-option::after{border:0}.language-option::before{content:"";position:absolute;top:10px;bottom:10px;left:2px;right:2px;z-index:-1;pointer-events:none;border-radius:999px}.home-page .language-option.selected{background:transparent;color:var(--text);font-weight:500}.language-option.selected::before{background:var(--selected)}
.locale-en .feature-title{font-size:40rpx;line-height:1.4}.locale-en .home-title{font-size:46rpx}.locale-en .feature-main{overflow:visible}.locale-en .quick-grid{align-items:stretch}.locale-en .guide-description{display:block;line-height:1.7}
