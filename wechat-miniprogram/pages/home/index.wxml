<view class="app-shell theme-{{themeId}} locale-{{locale}}"><app-header caption="{{copy.riichi_companion}}" />
<view class="page home-page safe-bottom"><view class="home-intro"><view class="home-meta-row"><text class="eyebrow">{{copy.know_the_score_of_every_hand}}</text><view class="language-switch" aria-role="radiogroup" aria-label="{{languageLabel}}"><button data-locale="zh-CN" bindtap="onLocale" aria-role="radio" aria-checked="{{locale === 'zh-CN'}}" class="language-option {{locale === 'zh-CN' ? 'selected' : ''}}"><text class="language-label">中文</text></button><button data-locale="ja" bindtap="onLocale" aria-role="radio" aria-checked="{{locale === 'ja'}}" class="language-option {{locale === 'ja' ? 'selected' : ''}}"><text class="language-label">日本語</text></button><button data-locale="en" bindtap="onLocale" aria-role="radio" aria-checked="{{locale === 'en'}}" class="language-option {{locale === 'en' ? 'selected' : ''}}"><text class="language-label">English</text></button></view></view><view class="home-title">{{copy.start_with_a_good_hand}}</view><view class="home-subtitle">{{copy.enter_hands_explore_yaku_practice_or_keep_score}}</view></view>
<button class="home-feature feature-main" data-id="riichi" bindtap="onModule"><view class="feature-copy"><text class="feature-index">{{copy.label_01_score_calculator}}</text><view class="feature-title">{{copy.enter_a_hand}}<view>{{copy.make_every_han_count}}</view></view><text class="feature-link">{{copy.calculate_a_hand}}</text></view><view class="home-tiles"><view class="home-tile-back"><mahjong-tile tile="m5" size="cover" /></view><view class="home-tile-front"><mahjong-tile tile="z7" size="cover" /></view></view></button>
<button class="home-feature feature-guide" data-id="guide" bindtap="onModule"><image class="feature-symbol" src="/assets/icons/book-{{themeId}}.svg" mode="aspectFit" aria-hidden="true"/><view><view class="guide-title">{{copy.yaku_handbook}}</view><text class="guide-description">{{copy.look_up_everyday_yaku_and_yakuman}}</text></view><text class="feature-arrow">›</text></button>
<view class="quick-grid"><button wx:for="{{quickModules}}" wx:key="id" class="home-feature quick-card" data-id="{{item.id}}" bindtap="onModule"><image class="quick-symbol" src="/assets/icons/{{item.id === 'practice' ? 'target' : 'table'}}-{{themeId}}.svg" mode="aspectFit" aria-hidden="true"/><view class="quick-title">{{item.name}}</view><view class="quick-description">{{item.id === 'practice' ? copy.build_scoring_skills_with_random_hands : copy.keep_four_players_scores_on_one_device}}</view><text class="quick-action">{{item.id === 'practice' ? copy.start_with_the_basics : copy.create_a_local_table}}　›</text></button></view>
<button class="history-link" bindtap="onHistory"><image class="history-symbol" src="/assets/icons/history-{{themeId}}.svg" mode="aspectFit" aria-hidden="true"/><text>{{copy.hand_history}}</text><text>→</text></button>
</view></view>
