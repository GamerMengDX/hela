<template name="full-row"><view class="teaching-full-row"><view wx:for="{{tiles}}" wx:key="rowIndex" class="teaching-strip-tile {{item.winning ? 'winning' : ''}} {{item.groupStart ? 'meld-start' : ''}}"><view class="teaching-strip-box"><image class="teaching-strip-image" src="/assets/tiles/{{item.tile}}.png" mode="aspectFit" aria-label="{{item.name}}{{item.winning ? copy.winning_tile_3 : ''}}"/></view><text wx:if="{{item.winning}}" class="teaching-strip-win">{{copy.winning_tile}}</text></view></view></template>
<view class="app-shell fixed-shell theme-{{themeId}} locale-{{locale}} teaching-page">
<app-header caption="{{copy.teaching_examples}}"/>
<view class="teaching-page-nav"><button class="teaching-back" bindtap="onBack">‹ {{course.stage === 'list' ? copy.yaku_handbook : course.stage === 'practice' ? copy.hand_analysis : copy.example_list}}</button><text class="teaching-muted">{{course.stage === 'list' ? course.total + copy.examples : course.stage === 'practice' ? copy.hand_building_practice : (course.selectedIndex + 1) + ' / ' + course.total}}</text></view>
<scroll-view class="teaching-scroll" scroll-y enhanced show-scrollbar="{{false}}" scroll-top="{{scrollTop}}" scroll-into-view="{{scrollTarget}}" bindscroll="onScroll">
<view class="teaching-content">
<block wx:if="{{course.stage === 'list'}}">
<view class="teaching-eyebrow">{{copy.eyebrow_teaching}}</view><view class="teaching-title">{{copy.choose_a_hand_understand_its_score}}</view><view class="teaching-intro">{{copy.explore_a_full_hand_and_its_score_then}}</view>
<view class="teaching-filters"><button wx:for="{{course.categories}}" wx:key="id" class="chip {{course.category === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="onFilter">{{item.name}}</button></view>
<button wx:for="{{course.examples}}" wx:key="index" class="teaching-case {{course.selectedIndex === item.index ? 'selected' : ''}}" data-index="{{item.index}}" bindtap="onSelect"><view class="teaching-case-top"><text class="teaching-case-name">{{item.name}}</text><text class="teaching-arrow">›</text></view><view class="teaching-muted">{{item.description}}</view><template is="full-row" data="{{tiles:item.tiles,copy:copy}}"/><view class="teaching-case-bottom"><text class="teaching-muted">{{item.handCountText}}</text><text class="teaching-case-score">{{item.summary}} · {{item.points}} {{copy.points}}</text></view></button>
</block>
<block wx:elif="{{course.stage === 'detail'}}">
<view class="teaching-eyebrow">{{copy.teaching_example_hand_analysis}}</view><view class="teaching-title">{{course.detail.name}}</view>
<view class="teaching-context-action"><view><view class="teaching-intro">{{course.detail.description}}</view><view class="teaching-context">{{course.detail.context.round}} · {{course.detail.context.seat}}（{{course.detail.context.role}}）<view>{{course.detail.context.method}} · {{course.detail.context.riichi}}{{course.detail.context.special ? ' · ' + course.detail.context.special : ''}}</view></view></view><button class="teaching-entry" bindtap="onTry" aria-label="{{copy.try_it_yourself_open_hand_building_practice}}" hover-class="teaching-entry-pressed" hover-start-time="0" hover-stay-time="90"><view class="teaching-entry-icon" aria-hidden="true"><view class="entry-cell entry-cell-a"></view><view class="entry-cell entry-cell-b"></view><view class="entry-cell entry-cell-c"></view><view class="entry-cell-plus"></view></view><text>{{copy.try_it_yourself}}</text></button></view>
<view class="teaching-section"><view class="teaching-section-title">{{copy.complete_hand}}<text class="teaching-muted">{{course.detail.physicalCount}}{{copy.tiles_includes_winning_tile_and_melds}}</text></view><template is="full-row" data="{{tiles:course.detail.rowTiles,copy:copy}}"/><view class="teaching-row-legend">{{copy.winning_tile_2}}{{course.detail.winTileName}}</view><view wx:for="{{course.detail.meldSummary}}" wx:key="*this" class="teaching-meld-summary">{{copy.meld}}{{item}}</view></view>
<view wx:if="{{course.detail.dora.length}}" class="teaching-section"><view class="teaching-section-title">{{copy.dora_indicators}}</view><view wx:for="{{course.detail.dora}}" wx:key="index" class="teaching-bonus"><image class="teaching-face" src="/assets/tiles/{{item.tile}}.png" mode="aspectFit"/><text class="teaching-muted">{{item.name}}{{copy.label}}{{item.actualName}}</text></view></view>
<view class="teaching-result"><text class="teaching-muted">{{course.detail.context.role}} · {{course.detail.context.method}}{{course.detail.score.limit ? ' · ' + course.detail.score.limit : ''}}</text><view class="teaching-points">{{course.detail.score.total}}<text>{{copy.points}}</text></view><text>{{course.detail.score.summary}}</text></view>
<view class="teaching-section"><view class="teaching-section-title">{{copy.yaku_and_han}}</view><view wx:for="{{course.detail.score.yaku}}" wx:key="name" class="teaching-yaku"><view class="teaching-row"><text>{{item.name}}</text><text>{{item.label}}</text></view><view class="teaching-muted">{{item.description}}</view></view></view>
<view class="teaching-section"><view class="teaching-section-title">{{copy.fu_breakdown}}</view><view wx:for="{{course.detail.score.fuDetails}}" wx:key="name" class="teaching-row"><text>{{item.name}}</text><text>{{item.fu === null ? '—' : item.fu + copy.fu_2}}</text></view></view>
<view class="teaching-section"><view class="teaching-section-title">{{copy.payments}}</view><view wx:for="{{course.detail.score.payments}}" wx:key="wind" class="teaching-row"><text>{{item.label}}</text><text>{{item.amount}} {{copy.points}}</text></view></view>
<button class="teaching-try full" bindtap="onTry">{{copy.try_building_this_hand}}</button><view class="teaching-end">{{copy.fixed_teaching_scenario_0_honba_0_deposits_not}}</view>
</block>
<block wx:elif="{{course.stage === 'practice'}}">
<view class="teaching-eyebrow">{{copy.try_it_yourself_hand_building_practice}}</view><view class="teaching-title">{{course.exercise.goal.name}}</view><view class="teaching-intro">{{course.exercise.goal.description}}<view>{{copy.build_the_target_yaku_your_tiles_and_score}}</view></view>
<view class="teaching-goal"><view class="teaching-tags"><text wx:for="{{course.exercise.goal.targets}}" wx:key="key">{{item.name}}</text></view><view class="teaching-muted">{{course.exercise.goal.context.round}} · {{course.exercise.goal.context.seat}} · {{course.exercise.goal.context.method}} · {{course.exercise.goal.context.riichi}}{{course.exercise.goal.context.special ? ' · ' + course.exercise.goal.context.special : ''}}</view><view wx:if="{{course.exercise.goal.indicators.length}}" class="teaching-muted">{{copy.fixed_dora_indicators}}<text wx:for="{{course.exercise.goal.indicators}}" wx:key="index">{{item.name}} </text></view></view>
<view class="teaching-section"><view class="teaching-row teaching-tray-heading"><text>{{copy.your_hand}}{{course.exercise.handCount}} / {{course.exercise.expected}}</text><view class="teaching-tools"><button disabled="{{!course.exercise.canUndo}}" data-action="undo" bindtap="onExercise">{{copy.undo}}</button><button disabled="{{!course.exercise.handCount && !course.exercise.meldCount && !course.exercise.draftTiles.length}}" data-action="clear" bindtap="onExercise">{{copy.clear}}</button></view></view>
<view class="teaching-full-row exercise-row"><block wx:for="{{course.exercise.rowTiles}}" wx:key="rowIndex"><button wx:if="{{item.kind === 'hand'}}" class="teaching-strip-tile {{item.winning ? 'winning' : ''}} {{item.empty ? 'empty-slot' : ''}}" data-action="{{item.empty ? 'input-hand' : 'hand'}}" data-value="{{item.index}}" bindtap="onExercise" aria-label="{{item.empty ? copy.add_a_hand_tile : item.name + (course.exercise.winMode ? copy.select_as_winning_tile : copy.tap_to_remove)}}"><view class="teaching-strip-box"><text wx:if="{{item.empty}}" class="teaching-plus">+</text><image wx:else class="teaching-strip-image" src="/assets/tiles/{{item.tile}}.png" mode="aspectFit"/></view><text wx:if="{{item.winning}}" class="teaching-strip-win">{{copy.winning_tile}}</text></button><view wx:else class="teaching-strip-tile {{item.groupStart ? 'meld-start' : ''}}"><view class="teaching-strip-box"><image class="teaching-strip-image" src="/assets/tiles/{{item.tile}}.png" mode="aspectFit"/></view></view></block></view>
<view class="teaching-row"><text class="teaching-muted">{{course.exercise.winMode ? copy.choose_a_hand_tile_as_the_winning_tile : course.exercise.remaining ? course.exercise.remainingHint : copy.the_hand_is_full_the_last_tile_is}}</text><button class="teaching-mini {{course.exercise.winMode ? 'selected' : ''}}" disabled="{{course.exercise.remaining > 0}}" data-action="win" bindtap="onExercise">{{copy.select_winning_tile}}</button></view>
<view wx:for="{{course.exercise.groups}}" wx:key="index" class="teaching-row"><text class="teaching-muted">{{item.name}} · {{item.text}}</text><button class="teaching-mini" data-action="remove-meld" data-value="{{item.index}}" bindtap="onExercise">{{copy.remove}}</button></view>
<button wx:if="{{course.exercise.target !== 'meld'}}" class="teaching-mini" disabled="{{course.exercise.meldCount >= 4}}" data-action="begin-meld" bindtap="onExercise">{{copy.add_meld_kan}}</button>
</view>
<view wx:if="{{course.exercise.target === 'meld'}}" class="teaching-section teaching-meld-editor"><view class="teaching-section-title">{{copy.build_meld_kan}}<text class="teaching-muted">{{course.exercise.draftTiles.length}} / {{course.exercise.required}}</text></view><view class="teaching-group-types"><button wx:for="{{course.exercise.groupTypes}}" wx:key="id" class="chip {{course.exercise.meldType === item.id ? 'selected' : ''}}" data-action="meld-type" data-value="{{item.id}}" bindtap="onExercise">{{item.name}}</button></view><view class="teaching-draft"><button wx:for="{{course.exercise.draftTiles}}" wx:key="index" data-action="draft-remove" data-value="{{item.index}}" bindtap="onExercise"><image class="teaching-face" src="/assets/tiles/{{item.tile}}.png" mode="aspectFit"/></button><text class="teaching-muted">{{!course.exercise.draftTiles.length ? copy.choose_tiles_with_the_keypad_below : copy.tap_a_tile_to_remove_it}}</text></view><view class="teaching-row"><button class="teaching-mini" data-action="cancel-meld" bindtap="onExercise">{{copy.cancel}}</button><button class="teaching-try" disabled="{{course.exercise.draftTiles.length !== course.exercise.required}}" data-action="confirm-meld" bindtap="onExercise">{{copy.confirm_meld}}</button></view></view>
<view class="teaching-section teaching-keyboard"><view class="teaching-row"><text class="teaching-muted">{{course.exercise.target === 'meld' ? copy.add_to_meld : copy.add_to_hand}}</text><button class="teaching-mini {{course.exercise.red ? 'selected' : ''}}" disabled="{{course.exercise.suit === 'z'}}" data-action="red" bindtap="onExercise">{{course.exercise.red ? copy.red_five_2 : copy.red_five_3}}</button></view><view class="teaching-suits"><button wx:for="{{suits}}" wx:key="id" class="chip {{course.exercise.suit === item.id ? 'selected' : ''}}" data-action="suit" data-value="{{item.id}}" bindtap="onExercise">{{item.name}}</button></view><view class="teaching-key-grid"><button wx:for="{{course.exercise.palette}}" wx:key="tile" class="teaching-key" disabled="{{item.disabled}}" data-action="add" data-value="{{item.tile}}" bindtap="onExercise" aria-label="{{item.name}}"><image src="/assets/tiles/{{item.tile}}.png" mode="aspectFit"/><text wx:if="{{item.count}}">{{item.count}} / 4</text></button></view></view>
<view wx:if="{{course.exercise.error}}" class="teaching-feedback failure">{{course.exercise.error}}</view>
<view id="exercise-feedback" wx:if="{{course.exercise.feedback}}" class="teaching-feedback {{course.exercise.feedback.correct ? 'success' : 'failure'}}"><view class="teaching-section-title">{{course.exercise.feedback.title}}</view><view>{{course.exercise.feedback.message}}</view><block wx:if="{{course.exercise.feedback.detail}}"><view class="teaching-feedback-score">{{course.exercise.feedback.detail.score.total}}{{copy.points_3}}{{course.exercise.feedback.detail.score.summary}}</view><view wx:for="{{course.exercise.feedback.detail.score.yaku}}" wx:key="name" class="teaching-row"><text>{{item.name}}</text><text>{{item.label}}</text></view></block></view>
<view class="teaching-end">{{copy.each_meld_uses_three_hand_slots_a_kan}}</view>
</block>
</view></scroll-view>
<view wx:if="{{course.stage === 'practice'}}" class="teaching-footer"><button class="teaching-mini" bindtap="onBack">{{copy.view_example}}</button><button class="teaching-try" data-action="judge" bindtap="onExercise">{{copy.check_hand}}</button></view>
</view>
