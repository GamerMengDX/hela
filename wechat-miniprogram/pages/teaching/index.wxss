var(--radius);background:var(--surface);margin-bottom:20rpx}.teaching-section-title{font-size:25rpx;font-weight:550;margin-bottom:20rpx;display:flex;align-items:center;gap:14rpx}.teaching-section-title .teaching-muted{font-size:18rpx;font-weight:400}.teaching-face{display:block;width:62rpx;height:87rpx;flex:none}.teaching-bonus{display:flex;align-items:center;gap:20rpx}.teaching-result{text-align:center;border:1rpx solid var(--line);border-radius:var(--radius);padding:28rpx 20rpx;margin-bottom:20rpx;background:var(--selected);color:var(--text);font-size:26rpx}.teaching-points{font:550 66rpx/1.5 var(--heading-font);margin:7rpx 0}.teaching-points>text{font:22rpx -apple-system,sans-serif;margin-left:9rpx}.teaching-row{display:flex;align-items:center;justify-content:space-between;gap:16rpx;font-size:23rpx;line-height:1.8;padding:9rpx 0}.teaching-yaku{margin-bottom:14rpx}.teaching-yaku .teaching-muted{font-size:20rpx}.teaching-end{text-align:center;font-size:20rpx;line-height:1.8;color:var(--muted);padding:22rpx 12rpx 20rpx}.teaching-full-row{display:flex;align-items:flex-start;gap:3rpx;width:100%;margin-top:8rpx}.teaching-strip-tile{position:relative;flex:1;min-width:0;padding:0 0 25rpx;margin:0;background:none;border:0;overflow:visible}.teaching-strip-tile.meld-start{margin-left:10rpx}.teaching-strip-box{position:relative;display:block;width:100%;padding-top:140%;border-radius:4rpx}.teaching-strip-image{position:absolute;inset:0;display:block;width:100%;height:100%}.teaching-strip-tile.winning .teaching-strip-box{outline:2rpx solid var(--accent);outline-offset:1rpx;background:var(--selected)}.teaching-strip-tile.winning{margin-left:7rpx}.teaching-strip-win{position:absolute;bottom:1rpx;left:0;right:0;text-align:center;color:var(--accent);font-size:15rpx;line-height:1.4;white-space:nowrap}.teaching-case .teaching-full-row{margin-top:22rpx}.teaching-case-bottom{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin-top:12rpx}.teaching-case-bottom .teaching-muted{font-size:18rpx}.teaching-row-legend,.teaching-meld-summary{font-size:21rpx;line-height:1.8;color:var(--muted);margin-top:12rpx}.teaching-row-legend{color:var(--accent)}.teaching-goal{border-left:4rpx solid var(--accent);padding:8rpx 20rpx;margin-bottom:26rpx}.teaching-tags{display:flex;flex-wrap:wrap;gap:10rpx;margin-bottom:12rpx}.teaching-tags text{font-size:22rpx;padding:7rpx 12rpx;border-radius:8rpx;background:var(--selected);color:var(--accent)}.teaching-tools{display:flex;gap:8rpx}.teaching-tools button,.teaching-mini{min-height:76rpx;padding:16rpx 12rpx;background:transparent;border:1rpx solid var(--line);color:var(--accent);font-size:21rpx;border-radius:10rpx}.teaching-tools button{border:0}.teaching-mini.selected{background:var(--selected)}.teaching-tray-heading{padding-top:0}.teaching-tray-heading>text{font-size:24rpx;font-weight:550}.empty-slot .teaching-strip-box{border:1rpx dashed var(--line);background:var(--surface)}.teaching-plus{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:25rpx;color:var(--muted)}.teaching-draft{display:flex;gap:12rpx;align-items:center;min-height:110rpx;margin-bottom:20rpx}.teaching-draft button{padding:0;background:none}.teaching-keyboard>.teaching-row{padding-top:0;margin-bottom:16rpx}.teaching-suits{margin-bottom:16rpx}.teaching-key-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx}.teaching-key{position:relative;height:108rpx;display:flex;align-items:center;justify-content:center;background:var(--surface);border:1rpx solid var(--line);border-radius:12rpx;padding:7rpx}.teaching-key image{display:block;width:60rpx;height:88rpx}.teaching-key>text{position:absolute;bottom:8rpx;right:10rpx;font-size:17rpx;color:var(--muted)}.teaching-feedback{padding:24rpx;border:1rpx solid var(--line);border-radius:var(--radius);background:var(--selected);font-size:23rpx;line-height:1.8;margin:20rpx 0}.teaching-feedback.failure{border-left:4rpx solid var(--danger)}.teaching-feedback.success{border-left:4rpx solid var(--accent)}.teaching-feedback-score{font-weight:550;margin-top:18rpx}.teaching-footer{display:flex;gap:18rpx;flex:none;padding:16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));background:var(--solid);border-top:1rpx solid var(--line)}.teaching-footer .teaching-try{flex:1}.teaching-case:active,.teaching-key:active,.teaching-mini:active{background:var(--selected)}
/* Native buttons have an intrinsic width; let each learning layout own it. */
.teaching-page button{width:auto;min-width:0;margin:0}.teaching-page .teaching-case,.teaching-page .full{width:100%}.teaching-page-nav .teaching-back{flex:none;text-align:left}.teaching-filters button,.teaching-suits button,.teaching-group-types button{width:0;flex:1}.teaching-key-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.teaching-page .teaching-key{width:100%;min-width:0}.teaching-page .teaching-strip-tile{width:0;flex:1}.teaching-page .teaching-strip-tile.winning{margin-left:7rpx}.teaching-tray-heading>text{flex:1;min-width:0}.teaching-tools{flex:none}.teaching-footer .teaching-try{width:0;flex:1}.teaching-row>.teaching-mini{flex:none}.teaching-key image{pointer-events:none}

/* Selected entry 01: a fine outline capsule; practice actions keep their primary style. */
.teaching-page.theme-moon{--teaching-entry-line:rgba(191,220,234,.28);--teaching-entry-surface:rgba(45,69,83,.52)}
.teaching-page.theme-mist{--teaching-entry-line:rgba(65,110,145,.28);--teaching-entry-surface:rgba(238,244,247,.52)}
.teaching-page.theme-retro{--teaching-entry-line:rgba(49,84,61,.28);--teaching-entry-surface:rgba(245,237,218,.52)}
.teaching-page .teaching-entry{display:inline-flex;align-items:center;justify-content:center;gap:12rpx;flex:none;min-height:88rpx;padding:0 26rpx;margin:0;border:2rpx solid var(--teaching-entry-line);border-radius:999rpx;background:var(--teaching-entry-surface);color:var(--accent);font-size:26rpx;font-weight:500;line-height:1.5;white-space:nowrap;transition:transform 120ms ease-out}
.teaching-entry-icon{position:relative;display:block;width:30rpx;height:30rpx;flex:none;opacity:.9}
.entry-cell{position:absolute;width:9rpx;height:9rpx;border:2rpx solid currentColor;border-radius:3rpx}.entry-cell-a{left:4rpx;top:4rpx}.entry-cell-b{right:3rpx;top:4rpx}.entry-cell-c{left:4rpx;bottom:3rpx}.entry-cell-plus{position:absolute;width:10rpx;height:10rpx;right:3rpx;bottom:3rpx}.entry-cell-plus::before,.entry-cell-plus::after{content:"";position:absolute;background:currentColor;border-radius:1rpx}.entry-cell-plus::before{left:0;right:0;top:4rpx;height:2rpx}.entry-cell-plus::after{top:0;bottom:0;left:4rpx;width:2rpx}
.teaching-page .teaching-entry-pressed{transform:scale(.97);background:var(--selected)}
@media(prefers-reduced-motion:reduce){.teaching-page .teaching-entry{transition:none}}
