@import '../../styles/themes.wxss';
:host{display:block;flex-shrink:0}.header-root{color:var(--text)}.app-header{display:flex;align-items:center;gap:16rpx;height:104rpx;padding:0 32rpx;background:var(--nav-bg);color:var(--nav-text)}.header-brand,.skin-trigger,.help-trigger,.header-close,.theme-choice,.header-root .history-button{margin:0;line-height:1.4;background:none;color:inherit}.header-brand::after,.skin-trigger::after,.help-trigger::after,.header-close::after,.theme-choice::after,.history-button::after{border:0}.header-root .header-brand{display:flex;align-items:center;gap:15rpx;padding:0;font:500 33rpx var(--heading-font);white-space:nowrap}.header-sign{display:flex;align-items:center;justify-content:center;width:43rpx;height:51rpx;border-radius:9rpx;background:var(--logo-bg);color:var(--logo-ink);font:32rpx "Songti SC",serif}.header-caption{font-size:17rpx;opacity:.65;white-space:nowrap}.header-tools{display:flex;align-items:center;gap:8rpx;margin-left:auto}.header-root .skin-trigger{display:flex;align-items:center;justify-content:center;width:88rpx;height:88rpx;padding:0;border:0;border-radius:50%;opacity:.9}.skin-icon{display:block;width:44rpx;height:44rpx}.header-root .skin-trigger-pressed{background:var(--surface)}.header-root .help-trigger{display:flex;align-items:center;justify-content:center;width:88rpx;height:88rpx;padding:0;line-height:1;border-radius:50%;opacity:.9}.help-symbol{display:flex;align-items:center;justify-content:center;width:44rpx;height:44rpx;border:1.5rpx solid currentColor;border-radius:50%;font-size:26rpx;font-weight:500;line-height:1}.help-trigger-pressed .help-symbol{background:var(--selected)}.theme-backdrop{position:fixed;inset:0;z-index:500;display:flex;align-items:flex-end;background:#10233280}.theme-sheet{width:100%;background:var(--solid);color:var(--text);padding:34rpx 32rpx calc(34rpx + env(safe-area-inset-bottom));border-radius:30rpx 30rpx 0 0;border:1rpx solid var(--line)}.theme-sheet-heading{display:flex;justify-content:space-between;align-items:center;font:500 36rpx var(--heading-font);margin-bottom:30rpx}.header-root .header-close{font-size:33rpx;width:68rpx;padding:10rpx}.header-root .theme-choice{display:flex;align-items:center;gap:24rpx;width:100%;padding:24rpx;text-align:left;border:1rpx solid var(--line);border-radius:var(--radius);background:var(--surface);margin-bottom:20rpx}.theme-choice.selected{border-color:var(--accent)}.theme-swatch{width:95rpx;height:91rpx;border-radius:9rpx;display:flex;align-items:center;justify-content:center;border:1rpx solid #aabbcc44;font:35rpx serif;flex-shrink:0}.swatch-bar{width:11rpx;height:39rpx;border-radius:3rpx;background:currentColor;opacity:.3;margin-left:12rpx}.theme-choice-name{display:block;font-size:29rpx;letter-spacing:2rpx}.theme-choice-note{display:block;font-size:19rpx;color:var(--muted);margin-top:9rpx}.theme-check{margin-left:auto;color:var(--accent)}.theme-sheet-note{font-size:20rpx;line-height:1.9;color:var(--muted);margin-top:23rpx}.help-section-title{display:block;font-size:26rpx;margin:26rpx 0 15rpx}.help-section-copy{font-size:23rpx;color:var(--muted);line-height:2}.header-root .history-button{width:100%;margin-top:30rpx;background:var(--action);color:var(--action-ink);padding:23rpx;border-radius:var(--radius);font-size:24rpx}

.header-root .header-brand{width:auto;flex-shrink:0}.header-root .skin-trigger{flex:none}.header-root .help-trigger{flex:none}.header-tools{flex-shrink:0}

.header-root .header-brand,.header-root .skin-trigger,.header-root .help-trigger,.header-root .header-close,.header-root .theme-choice,.header-root .history-button{margin-left:0;margin-right:0}.header-root .help-trigger{background:none}.header-root .theme-choice{width:100%}
.header-root .header-close{width:68rpx;min-height:68rpx;flex:none;padding:10rpx}

.header-sign,.header-root .theme-choice{box-shadow:var(--surface-shadow,none)}
.header-root .header-brand{width:88rpx;height:88rpx;display:flex;justify-content:center;align-items:center;border-radius:18rpx;flex:none}
.header-avatar-mask{position:relative;display:block;width:64rpx;height:64rpx;flex:none;overflow:hidden;border-radius:50%;background:#0b4933}.header-avatar{position:absolute;display:block;width:126%;height:126%;left:-13%;top:-9%;max-width:none;border-radius:0}
.header-avatar-fallback{display:flex;align-items:center;justify-content:center;width:100%;height:100%;color:#f7efd9;font:24rpx "Songti SC",serif}

.header-root{font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}.app-header,.header-brand,.header-tools,.skin-trigger,.help-trigger,.header-close,.theme-sheet,.theme-choice{box-sizing:border-box}

.theme-sheet{max-height:90vh;overflow-y:auto}.theme-choice-copy{min-width:0;flex:1}.theme-choice-note{white-space:normal;overflow-wrap:anywhere;line-height:1.7}.locale-en .theme-sheet-heading{font-size:31rpx}.locale-en .help-section-title{line-height:1.6}.locale-en .history-button{white-space:normal;line-height:1.6}
