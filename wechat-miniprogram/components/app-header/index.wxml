<view class="header-root theme-{{themeId}} locale-{{locale}}">
  <view class="app-header"><button class="header-brand" style="width:88rpx;height:88rpx;flex:0 0 88rpx" bindtap="onHome" aria-label="{{copy.return_home_2}}"><view class="header-avatar-mask" style="width:64rpx;height:64rpx;border-radius:50%;overflow:hidden;position:relative"><text wx:if="{{iconFailed}}" class="header-avatar-fallback" aria-hidden="true">和啦</text><image wx:else class="header-avatar" style="position:absolute;width:126%;height:126%;left:-13%;top:-9%" src="/assets/app-icon.png" mode="aspectFill" binderror="onIconError" aria-hidden="true"/></view></button><view class="header-tools"><button class="skin-trigger" bindtap="onThemes" hover-class="skin-trigger-pressed" aria-label="{{copy.change_theme}}"><image class="skin-icon" src="/assets/icons/palette-{{themeId}}.svg" mode="aspectFit" aria-hidden="true" /></button><button class="help-trigger" bindtap="onHelp" hover-class="help-trigger-pressed" aria-label="{{copy.how_to_use}}"><text class="help-symbol" aria-hidden="true">?</text></button></view></view>
  <view wx:if="{{showThemes || showHelp}}" class="theme-backdrop" bindtap="onClose"><view class="theme-sheet" catchtap="noop"><view class="theme-sheet-heading"><text>{{showThemes ? copy.choose_a_theme : copy.how_to_use}}</text><button class="header-close" bindtap="onClose" aria-label="{{copy.close}}">×</button></view>
    <block wx:if="{{showThemes}}"><button wx:for="{{themes}}" wx:key="id" class="theme-choice {{themeId === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="onTheme" aria-pressed="{{themeId === item.id}}"><view class="theme-swatch" style="background:{{item.background}};color:{{item.accent}}"><text>和</text><view class="swatch-bar"></view></view><view class="theme-choice-copy"><text class="theme-choice-name">{{item.name}}</text><text class="theme-choice-note">{{item.description}}</text></view><text class="theme-check">{{themeId === item.id ? '✓' : ''}}</text></button><view class="theme-sheet-note">{{copy.all_three_themes_share_a_layout_and_keep}}</view></block>
    <block wx:else><view class="header-help"><text class="help-section-title">{{copy.enter_hands_explore_yaku_practice_and_keep_score}}</text><view class="help-section-copy">{{copy.enter_tiles_with_the_keypad_the_winning_slot}}</view><text class="help-section-title">{{copy.your_data_stays_on_this_device}}</text><view class="help-section-copy">{{copy.themes_drafts_practice_stats_and_tables_are_stored}}</view><button class="history-button" bindtap="onHistory">{{copy.view_hand_history}}</button></view></block>
  </view></view>
</view>
