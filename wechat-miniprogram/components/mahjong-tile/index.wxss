:host{display:inline-block;vertical-align:middle;flex-shrink:0}.tile-wrap{position:relative;width:65rpx;height:90rpx}.tile{width:100%;height:100%;border-radius:8rpx;background:var(--surface);box-shadow:0 5rpx 0 var(--shadow);overflow:hidden;border:1rpx solid var(--line)}.artwork{display:block;width:100%;height:100%}.placeholder{height:100%;display:flex;align-items:center;justify-content:center;font-size:37rpx;color:var(--muted);border:1rpx dashed var(--line);background:var(--surface)}.tile.selected{border:3rpx solid var(--line);box-shadow:0 5rpx 0 var(--shadow),0 0 0 5rpx var(--shadow)}.tile.disabled{opacity:.43}.tile-hover{opacity:.8}.remove{position:absolute;right:-6rpx;top:-7rpx;width:23rpx;height:23rpx;line-height:21rpx;text-align:center;font-size:20rpx;background:var(--surface);border:2rpx solid var(--line);color:white;border-radius:50%;z-index:1}.hand{width:56rpx;height:78rpx}.small{width:47rpx;height:65rpx}.tiny{width:38rpx;height:53rpx}.meld{width:53rpx;height:74rpx}

.keyboard{width:59rpx;height:81rpx}

.entry{width:50rpx;height:72rpx}.keypad{width:64rpx;height:91rpx}.tile{background:#fafbf6;border:1rpx solid #ffffffaa;box-shadow:0 3rpx 0 var(--tile-shadow,#afc0c8);border-radius:7rpx}.tile.selected{border:1rpx solid #ffffffaa;box-shadow:0 3rpx 0 var(--tile-shadow,#afc0c8)}.tile.disabled{opacity:.3}

.review{display:flex;align-items:center;justify-content:center;width:88rpx;height:94rpx}.review .tile{width:56rpx;height:78rpx;flex:none}

.cover{width:96rpx;height:132rpx}
