@import './styles/themes.wxss';
page{background:var(--surface);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:26rpx;line-height:1.5}
view,text,button,input,scroll-view{box-sizing:border-box}button{margin:0;line-height:1.4;font-size:24rpx;font-weight:400;border-radius:10rpx}button::after{border:0}button[disabled]{color:var(--muted);background:var(--surface);opacity:.55}
.page{padding:28rpx 28rpx 44rpx}.eyebrow{font-size:17rpx;letter-spacing:3rpx;color:var(--muted)}.title{font-family:var(--heading-font);font-size:44rpx;font-weight:600;letter-spacing:1rpx;margin-top:10rpx}.subtitle{font-size:22rpx;line-height:1.9;color:var(--muted);margin-top:12rpx}.page-header{margin-bottom:30rpx}.card{background:var(--surface);border:1rpx solid var(--line);border-radius:20rpx;margin-bottom:28rpx;overflow:hidden;box-shadow:0 5rpx 12rpx var(--shadow)}.card-inner{padding:28rpx}.card-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:24rpx;flex-wrap:wrap;gap:12rpx}.heading-left{display:flex;align-items:center;gap:14rpx}.step{background:var(--surface);color:var(--accent);border-radius:9rpx;width:43rpx;height:43rpx;text-align:center;line-height:43rpx;font-size:22rpx;font-family:Georgia,serif}.section-title{font-size:28rpx;font-weight:600}.muted{color:var(--muted)}.small{font-size:21rpx}.caption{font-size:18rpx;color:var(--muted)}.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.primary{background:var(--surface);color:var(--muted);padding:22rpx 26rpx;font-size:25rpx;font-weight:500}.primary:active{background:var(--surface)}.outline{background:var(--surface);color:var(--accent);border:1rpx solid var(--line);padding:18rpx 23rpx}.text-button{background:transparent;color:var(--accent);font-size:20rpx;padding:8rpx 12rpx}.text-button:active{background:var(--surface)}.danger{color:var(--danger)}.chip{background:var(--surface);border:1rpx solid var(--line);border-radius:9rpx;padding:14rpx 19rpx;font-size:22rpx;color:var(--muted);line-height:1.4}.chip.selected{background:var(--surface);color:var(--accent);border-color:var(--line)}.chips{display:flex;gap:10rpx;flex-wrap:wrap}.field-label{font-size:23rpx;color:var(--accent);margin-bottom:16rpx;display:block}.field-note{font-size:19rpx;color:var(--muted);margin-top:12rpx;line-height:1.9}.divider{border-top:1rpx solid var(--line);margin:27rpx 0}.full{width:100%}.local-note{text-align:center;color:var(--muted);font-size:18rpx;margin:24rpx 0 8rpx}.empty{text-align:center;padding:66rpx 35rpx}.empty-title{font-family:var(--heading-font);font-size:35rpx;color:var(--accent);margin-bottom:17rpx}.empty-description{font-size:23rpx;color:var(--muted);line-height:2}.empty button{margin:32rpx auto 0;display:inline-block}.input{background:var(--surface);border:1rpx solid var(--line);border-radius:10rpx;padding:18rpx 21rpx;font-size:25rpx;color:var(--accent);min-height:78rpx}.badge{font-size:19rpx;padding:5rpx 10rpx;background:var(--surface);color:var(--muted);border-radius:7rpx}.button-row{display:flex;gap:15rpx;align-items:center}.safe-bottom{padding-bottom:env(safe-area-inset-bottom)}
.modal-backdrop{position:fixed;inset:0;background:var(--surface);z-index:100;display:flex;align-items:flex-end;justify-content:center}.sheet{background:var(--surface);width:100%;max-height:88vh;border-radius:26rpx 26rpx 0 0;padding:28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));box-shadow:0 -10rpx 55rpx var(--shadow)}.sheet-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:22rpx}.sheet-title{font-size:32rpx;font-weight:600;color:var(--accent)}.sheet-close{padding:8rpx 14rpx;font-size:28rpx;color:var(--muted);background:none}.sheet-scroll{max-height:65vh}.sheet-description{font-size:22rpx;color:var(--muted);line-height:1.9;margin-bottom:24rpx}

page{background:#263e4b;color:#edf4f5}.app-shell{min-height:100vh;background:var(--app-background);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}.fixed-shell{height:100vh;display:flex;flex-direction:column;overflow:hidden}.fixed-shell .practice-screen,.fixed-shell .lobby-screen,.fixed-shell .photo-screen{height:auto;min-height:0;flex:1}.app-shell .primary{background:var(--action);color:var(--action-ink);border-radius:var(--radius)}.app-shell .chip.selected{background:var(--selected);color:var(--selected-ink);border-color:var(--line)}.app-shell .card,.app-shell .context-card,.app-shell .result-card{border-radius:var(--radius);background:var(--surface);border-color:var(--line)}.app-shell .sheet{background:var(--solid);color:var(--text)}.app-shell .score-hero{background:var(--surface);color:var(--text);border:1rpx solid var(--line)}.app-shell .score-points,.app-shell .han-fu{color:var(--text)}.app-shell .page{padding-top:24rpx}.app-shell .title{font-family:var(--heading-font);font-weight:500}.app-shell .danger{color:var(--danger)}

.app-shell .card{box-shadow:var(--surface-shadow,0 5rpx 12rpx var(--shadow))}
.app-shell .entry-tray,.app-shell .entry-keyboard,.app-shell .entry-control,.app-shell .entry-utility,.app-shell .context-card,.app-shell .result-card{box-shadow:var(--surface-shadow,none)}
.app-shell .home-feature{box-shadow:var(--surface-shadow,0 5rpx 15rpx var(--shadow))}

/* Localized text may wrap and increase control/card height in all themes. */
.app-shell button{white-space:normal;overflow-wrap:anywhere}.app-shell .row{flex-wrap:wrap}.app-shell .button-row{flex-wrap:wrap}.app-shell .row>view,.app-shell .row>text{min-width:0}.locale-en .eyebrow{letter-spacing:1rpx}.locale-en .title{font-size:39rpx;line-height:1.4}.locale-en .chip{padding-left:14rpx;padding-right:14rpx}.locale-en .caption{line-height:1.6}.locale-en .field-label{line-height:1.6}.locale-en .sheet-title{min-width:0;overflow-wrap:anywhere}.locale-en .local-note{line-height:1.8}.locale-en .sheet-header{align-items:flex-start}
