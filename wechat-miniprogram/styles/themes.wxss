/* Keep the two frosted palettes aligned with the approved web design.
   The radial highlight and the base gradient paint once on the page shell;
   translucent panels reveal that same light instead of restarting it. */
.theme-moon{
  --bg:#263e4b;
  --panel:#334b59;
  --text:#edf4f5;
  --muted:#aac0cd;
  --line:#d6ebf124;
  --accent:#bfdcea;
  --on-accent:#294958;
  --soft:#3a5666;
  --surface:#c8dfea0c;
  --solid:#2d4553;
  --keyboard-panel:#c5dce911;
  --keyboard-text:#bfd2df;
  --nav-bg:transparent;
  --nav-text:#edf4f5;
  --logo-bg:#d7e9f017;
  --logo-ink:#dfedf4;
  --action:linear-gradient(150deg,#50778f,#355b72);
  --action-ink:#fff;
  --selected:#bad4e52a;
  --selected-ink:#eaf5fa;
  --surface-shadow:0 1rpx 0 #e6f6ff12 inset;
  --app-background:linear-gradient(180deg,#263e4b 0rpx,#263e4b 20rpx,#263e4b00 320rpx),radial-gradient(ellipse at 0% 0%,#78949e83,transparent 58%),linear-gradient(150deg,#203640,#263e4b 70%,#324c59);
  --heading-font:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;
  --radius:28rpx;
  --shadow:#142a3514;
  --danger:#eea69d;
  --tile-shadow:#afc0c8
}
.theme-mist{
  --bg:#e2ebef;
  --panel:#edf2f4;
  --text:#2a3b45;
  --muted:#657c8b;
  --line:#ffffff9c;
  --accent:#416e91;
  --on-accent:#fff;
  --soft:#dbe8ef;
  --surface:#ffffff52;
  --solid:#eef4f7;
  --keyboard-panel:#f7fafb80;
  --keyboard-text:#657c8b;
  --nav-bg:transparent;
  --nav-text:#2a3b45;
  --logo-bg:#ffffffb3;
  --logo-ink:#547384;
  --action:linear-gradient(155deg,#527da0,#3a6689);
  --action-ink:#fff;
  --selected:#ffffffd6;
  --selected-ink:#3c657e;
  --surface-shadow:0 1rpx 0 #ffffffa6 inset,0 5rpx 14rpx #3e586509;
  --app-background:linear-gradient(180deg,#e2ebef 0rpx,#e2ebef 20rpx,#e2ebef00 320rpx),radial-gradient(ellipse at 0% 0%,#ffffffd9,transparent 54%),linear-gradient(152deg,#e8eff1,#d6e1e7 65%,#e3ecef);
  --heading-font:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;
  --radius:28rpx;
  --shadow:#3e586510;
  --danger:#a44b43;
  --tile-shadow:#afc0c8
}
.theme-retro{--bg:#eee5d0;--panel:#f8efdc;--text:#303d32;--muted:#807d63;--line:#b6ab8c8c;--accent:#31543d;--on-accent:#fbf1d9;--soft:#e5dfc6;--surface:#f8f0dd;--solid:#f5edda;--keyboard-panel:#315b47;--keyboard-text:#d2d9b7;--nav-bg:#294d3d;--nav-text:#f4ebd2;--logo-bg:#a84c39;--logo-ink:#fff3da;--action:#31543d;--action-ink:#f8efd4;--selected:#eee4c9;--selected-ink:#35533c;--app-background:linear-gradient(150deg,#f8f0df,#eae0c6);--heading-font:"Songti SC","STSong",serif;--radius:6rpx;--shadow:#77582f10;--danger:#a44b43;--tile-shadow:#b7b391}
