# Dependencies and build output are never committed.
node_modules/
dist/
heybox-miniprogram/dist/
heybox-miniprogram/.vite-cache/
heybox-miniprogram/dev-*/
wechat-miniprogram/project.private.config.json

# Local editor / OS noise
.DS_Store
*.local

# Optional local sources for regenerating the split model. The generated
# segments under heybox-miniprogram/src/vision/generated ARE committed so a
# cold checkout can build without downloading or converting anything.
vision-models/*.onnx
tools/vision/.venv/
.venv-vision/

# Screenshots, diagnostics and fixtures stay local; the public tree only ever
# contains the synthetic example strip generated by scripts/generate-tile-art.mjs.
*.f32
